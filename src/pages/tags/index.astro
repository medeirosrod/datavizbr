---
// Tags: os temas do acervo, com corpo proporcional ao número de textos.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getAllTags } from '../../lib/data';

const allPosts = await getPosts();
const tagsMap = await getAllTags();

const tags = Array.from(tagsMap.entries())
  .map(([slug, count]) => ({ slug, count }))
  .sort((a, b) => b.count - a.count || a.slug.localeCompare(b.slug, 'pt-BR'));
const maior = tags[0]?.count ?? 1;
---

<BaseLayout title="Tags" description="Explore os textos do datavizbr por tema." tema="escuro">
  <header class="topo-pag grao">
    <div class="container cab">
      <h1>Temas</h1>
      <p class="apoio-mono lead">{`${tags.length} ${tags.length === 1 ? 'tema' : 'temas'} em ${allPosts.length} textos. Quanto maior o nome, mais textos.`}</p>
    </div>
  </header>

  <div class="container pagina">
    <ul class="nuvem">
      {tags.map(({ slug, count }) => (
        <li>
          <a href={`/tags/${slug}`} style={`--p:${(count / maior).toFixed(3)}`}>
            {slug}<sup class="mono">{count}</sup>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .cab { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; padding-block: 64px; }
  .cab h1 { font-size: clamp(64px, 11vw, 150px); line-height: .86; letter-spacing: -.045em; color: #fbf7ff; margin: 0; }
  .lead { color: rgba(255,255,255,.76); max-width: 38ch; text-align: right; margin: 0 0 8px; }
  .pagina { padding-block: 72px 112px; }
  .nuvem { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: baseline; }
  .nuvem a {
    font-family: var(--font-display); font-weight: 700; color: var(--dvb-ink); border-bottom: 0;
    font-size: calc(20px + var(--p) * 44px); letter-spacing: -.035em; line-height: 1;
    transition: color 160ms var(--ease-out);
  }
  .nuvem a:hover, .nuvem a:focus-visible { color: var(--lc-ink-orange); }
  .nuvem sup { font-size: 11px; font-weight: 400; letter-spacing: 0; color: var(--fg-meta); margin-left: 4px; vertical-align: super; }
  @media (max-width: 760px) {
    .cab { flex-direction: column; align-items: flex-start; padding-block: 36px; }
    .lead { text-align: left; font-size: 15px; }
    .pagina { padding-block: 48px 72px; }
  }
</style>
