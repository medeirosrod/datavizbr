---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.rascunho && !data.arquivo);

const tagsMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagsMap.set(tag, (tagsMap.get(tag) || 0) + 1);
  });
});

const tags = Array.from(tagsMap.entries())
  .map(([slug, count]) => ({ slug, count }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="Tags" description="Explore os posts do datavizbr por tópicos.">
  <section class="section-page">
    <div class="container">

      <header class="section-header">
        <h1>Tags</h1>
        <p class="section-subtitle">
          {tags.length} {tags.length === 1 ? 'tópico' : 'tópicos'} em {allPosts.length} posts
        </p>
      </header>

      <div class="tags-grid">
        {tags.map(({ slug, count }) => (
          <a href={`/tags/${slug}`} class="tag-card">
            <span class="tag-nome">{slug}</span>
            <span class="tag-count">{count} {count === 1 ? 'post' : 'posts'}</span>
          </a>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .section-page {
    padding-block: var(--space-40);
    border-bottom: 1px solid var(--border-default);
  }

  .section-header {
    margin-bottom: var(--space-32);
    max-width: 800px;
  }

  .section-header h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
    color: var(--fg-heading);
    margin-bottom: var(--space-6);
  }

  .section-subtitle {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--fg-body);
    margin: 0;
  }

  .tags-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .tag-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-8);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    color: inherit;
    transition: box-shadow 160ms ease, border-color 160ms ease;
  }

  .tag-card:hover {
    box-shadow: var(--elev-1);
    border-color: var(--color-primary);
    color: inherit;
  }

  .tag-nome {
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--fg-heading);
  }

  .tag-count {
    font-size: var(--fs-caption);
    color: var(--fg-meta);
    font-family: var(--font-mono);
  }
</style>
