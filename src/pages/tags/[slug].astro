---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllTags, getPostsPorTag } from '../../lib/data';

export async function getStaticPaths() {
  const tagsMap = await getAllTags();

  return Array.from(tagsMap.keys()).map(tag => ({
    params: { slug: tag },
    props: { tag },
  }));
}

interface Props { tag: string; }
const { tag } = Astro.props;

const posts = await getPostsPorTag(tag);
const total = `${posts.length} ${posts.length === 1 ? 'texto' : 'textos'}`;
---

<BaseLayout
  title={`#${tag}`}
  description={`${total} com a tag "${tag}" no datavizbr.`}
  tema="escuro"
>
  <header class="topo-pag grao">
    <div class="container cab">
      <div>
        <a href="/tags" class="voltar mono">← Todos os temas</a>
        <h1><em>#</em>{tag}</h1>
      </div>
      <p class="apoio-mono lead">{total}</p>
    </div>
  </header>

  <div class="container pagina">
    <div class="grade">
      {posts.map((post, i) => <PostCard post={post} indice={i} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .cab { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; padding-block: 56px 64px; }
  .voltar { font-size: 13px; color: var(--lc-peach); border-bottom: 0; }
  .voltar:hover { color: #fff; }
  .cab h1 { font-size: clamp(52px, 9vw, 128px); line-height: .9; letter-spacing: -.0135em; color: #fbf7ff; margin: 18px 0 0; overflow-wrap: anywhere; }
  .cab h1 em { font-style: normal; color: var(--lc-peach); }
  .lead { color: rgba(255,255,255,.76); margin: 0 0 8px; }
  .pagina { padding-block: 72px 112px; }
  .grade { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 32px; }
  @media (max-width: 1000px) { .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .cab { flex-direction: column; align-items: flex-start; gap: 16px; padding-block: 32px 40px; }
    .grade { grid-template-columns: 1fr; gap: 40px; }
    .pagina { padding-block: 40px 72px; }
  }
</style>
