---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AutorNome from '../../components/AutorNome.astro';
import { getSecaoLabel } from '../../consts';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.rascunho);

  const tagsSet = new Set<string>();
  allPosts.forEach(post => post.data.tags.forEach(tag => tagsSet.add(tag)));

  return Array.from(tagsSet).map(tag => ({
    params: { slug: tag },
    props: { tag },
  }));
}

interface Props { tag: string; }
const { tag } = Astro.props;

const allPosts = await getCollection('posts', ({ data }) => !data.rascunho);
const posts = allPosts
  .filter(post => post.data.tags.includes(tag))
  .sort((a, b) => new Date(b.data.publicado_em).getTime() - new Date(a.data.publicado_em).getTime());

const formatarData = (date: Date): string => {
  return new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric' }).format(new Date(date));
};
---

<BaseLayout
  title={`#${tag}`}
  description={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} com a tag "${tag}" no datavizbr.`}
>
  <section class="section-page">
    <div class="container">

      <header class="section-header">
        <a href="/tags" class="voltar">← Todas as tags</a>
        <h1>#{tag}</h1>
        <p class="section-subtitle">
          {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        </p>
      </header>

      <div class="posts-list">
        {posts.map(post => (
          <article class="post-item">
            <div class="post-meta">
              <span class={`badge badge-${post.data.secao}`}>
                {getSecaoLabel(post.data.secao)}
              </span>
              <span class="post-data t-caption">{formatarData(post.data.publicado_em)}</span>
            </div>
            <h2 class="post-titulo">
              <a href={`/posts/${post.id}`}>{post.data.titulo}</a>
            </h2>
            {post.data.descricao && (
              <p class="post-descricao">{post.data.descricao}</p>
            )}
            <div class="post-footer">
              <span class="t-caption"><AutorNome autorId={post.data.autores[0]?.id} /></span>
              {post.data.tags.length > 1 && (
                <div class="post-tags">
                  {post.data.tags.map(t => (
                    <a
                      href={`/tags/${t}`}
                      class:list={['post-tag', { 'post-tag-ativa': t === tag }]}
                    >
                      #{t}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .section-page {
    padding-block: var(--space-40);
    border-bottom: 1px solid var(--border-default);
  }

  .section-header {
    margin-bottom: var(--space-32);
    max-width: 800px;
  }

  .voltar {
    display: inline-block;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--fg-meta);
    margin-bottom: var(--space-10);
  }

  .voltar:hover {
    color: var(--color-primary);
  }

  .section-header h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
    color: var(--fg-heading);
    margin-bottom: var(--space-6);
  }

  .section-subtitle {
    font-size: var(--fs-body-lg);
    color: var(--fg-body);
    margin: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 800px;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--border-default);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-meta {
    display: flex;
    gap: var(--space-6);
    align-items: center;
  }

  .post-data {
    color: var(--fg-meta);
  }

  .post-titulo {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    font-weight: 700;
    color: var(--fg-heading);
    margin: 0;
  }

  .post-titulo a {
    color: inherit;
    border-bottom: none;
  }

  .post-titulo a:hover {
    color: var(--color-primary);
  }

  .post-descricao {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--fg-body);
    margin: 0;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .post-tag {
    font-size: var(--fs-caption);
    color: var(--fg-meta);
    border-bottom: none;
  }

  .post-tag:hover {
    color: var(--color-primary);
  }

  .post-tag-ativa {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
