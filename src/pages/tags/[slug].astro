---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Gera rotas para todas as tags únicas
export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.rascunho && !data.arquivo);

  const tagsSet = new Set<string>();
  allPosts.forEach(post => {
    post.data.tags.forEach(tag => tagsSet.add(tag));
  });

  return Array.from(tagsSet).map(tag => ({
    params: { slug: tag },
    props: { tag }
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;

// Carrega posts com esta tag específica
const allPosts = await getCollection('posts', ({ data }) => !data.rascunho && !data.arquivo);
const taggedPosts = allPosts
  .filter(post => post.data.tags.includes(tag))
  .sort((a, b) => new Date(b.data.publicado_em).getTime() - new Date(a.data.publicado_em).getTime());

const title = `Posts em "${tag}"`;
const description = `${taggedPosts.length} post${taggedPosts.length !== 1 ? 's' : ''} com a tag "${tag}"`;
---

<BaseLayout title={title} description={description}>
  <main class="container">
    <div class="section-header">
      <a href="/tags" class="back-link">← Voltar para tags</a>
      <h1 class="reveal">{tag}</h1>
      <p class="lead reveal">{taggedPosts.length} {taggedPosts.length === 1 ? 'post' : 'posts'}</p>
    </div>

    {taggedPosts.length > 0 ? (
      <div class="posts-grid stagger-children">
        {taggedPosts.map(post => (
          <article class="post-card">
            <div class="post-meta">
              <span class="post-section">{post.data.secao}</span>
              <time class="post-date">
                {new Date(post.data.publicado_em).toLocaleDateString('pt-BR', {
                  day: '2-digit',
                  month: '2-digit',
                  year: '2-digit'
                })}
              </time>
            </div>
            <h2 class="post-title">
              <a href={`/posts/${post.id}`}>{post.data.titulo}</a>
            </h2>
            {post.data.descricao && (
              <p class="post-description">{post.data.descricao}</p>
            )}
            <div class="post-tags">
              {post.data.tags.map(t => (
                <a href={`/tags/${t}`} class={`tag ${t === tag ? 'active' : ''}`}>
                  {t}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state reveal">
        <p>Nenhum post encontrado com esta tag.</p>
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-6);
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--fs-sm);
    transition: color var(--motion-fast) ease;
  }

  .back-link:hover {
    color: var(--color-primary-dark);
  }

  .section-header {
    margin-bottom: var(--space-20);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-default);
  }

  h1 {
    font-size: var(--fs-display);
    font-weight: 700;
    margin-bottom: var(--space-6);
    color: var(--fg-heading);
  }

  .lead {
    font-size: var(--fs-lg);
    color: var(--fg-meta);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-20);
  }

  .post-card {
    padding: var(--space-6);
    background: var(--bg-secondary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-medium);
    transition: all var(--motion-fast) ease;
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    font-size: var(--fs-caption);
  }

  .post-section {
    display: inline-block;
    padding: 2px 6px;
    background: var(--dvb-orange-100);
    color: var(--dvb-orange-900);
    border-radius: 3px;
    font-weight: 600;
    text-transform: capitalize;
  }

  .post-date {
    color: var(--fg-meta);
  }

  .post-title {
    font-size: var(--fs-lg);
    font-weight: 600;
    margin-bottom: var(--space-3);
    line-height: 1.4;
  }

  .post-title a {
    color: var(--fg-heading);
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .post-title a:hover {
    color: var(--color-primary);
  }

  .post-description {
    color: var(--fg-meta);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }

  .tag {
    display: inline-block;
    padding: 4px 8px;
    background: var(--fg-secondary);
    color: var(--bg-primary);
    border-radius: 3px;
    font-size: var(--fs-micro);
    text-decoration: none;
    transition: all var(--motion-fast) ease;
    text-transform: lowercase;
  }

  .tag:hover {
    background: var(--color-primary);
  }

  .tag.active {
    background: var(--color-primary);
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-20);
    color: var(--fg-meta);
  }

  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: var(--fs-2xl);
    }

    .lead {
      font-size: var(--fs-base);
    }
  }
</style>
