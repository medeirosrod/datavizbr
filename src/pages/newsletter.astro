---
import BaseLayout from '../layouts/BaseLayout.astro';
import Azulejo from '../components/Azulejo.astro';
import Selo from '../components/Selo.astro';
import { SITE } from '../consts';
import type { Secao } from '../lib/formas';

const itens: { secao: Secao; titulo: string; texto: string }[] = [
  { secao: 'praticas', titulo: 'Qual gráfico usar?', texto: 'Um PDF de bolso para escolher o gráfico pela pergunta, não pela aparência.' },
  { secao: 'panorama', titulo: 'Frequência mensal', texto: 'Primeiro domingo de cada mês. Um email, uma curadoria.' },
  { secao: 'bastidores', titulo: 'Foco no Brasil', texto: 'Projetos, publicações e acontecimentos da cena brasileira de dataviz.' },
  { secao: 'ensaios', titulo: 'Textos do acervo', texto: 'Links para posts recentes e clássicos do datavizbr que merecem revisita.' },
];
---

<BaseLayout
  title="Newsletter"
  description="A Eixo chega uma vez por mês: a curadoria do que rolou na cena brasileira de dataviz, mais o guia Qual gráfico usar? em PDF. Sem spam, sem patrocínio."
  tema="escuro"
>
  <header class="topo-pag grao">
    <div class="container topo">
      <div>
        <span class="eyebrow">Eixo, a newsletter do datavizbr</span>
        <h1>Todo primeiro domingo, <em>o melhor da dataviz brasileira.</em></h1>
        <p class="apoio-mono lead">Assine e receba o guia "Qual gráfico usar?" em PDF.</p>
        <form class="form" action={`${SITE.newsletter_url}/subscribe`} method="get">
          <input class="input" type="email" name="email" placeholder="seu@email.com" aria-label="Seu endereço de email" required />
          <button class="btn btn-sol" type="submit">Inscrever</button>
        </form>
        <p class="aviso">Você pode cancelar a qualquer momento. Os dados não são compartilhados com terceiros.</p>
      </div>

      <div class="guia" aria-hidden="true">
        <div class="guia-capa"><Azulejo secao="bastidores" colunas={4} linhas={4} /></div>
        <div class="guia-corpo">
          <b>Qual gráfico usar?</b>
          <span>Guia de bolso em PDF, grátis para quem assina</span>
        </div>
      </div>
    </div>
  </header>

  <section class="esperar container">
    <h2>O que esperar</h2>
    <ul class="itens">
      {itens.map((i) => (
        <li>
          <Selo secao={i.secao} tamanho={36} semNome />
          <h3>{i.titulo}</h3>
          <p>{i.texto}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .topo { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 72px; align-items: center; padding-block: 72px 88px; }
  .topo h1 { font-size: clamp(44px, 6.6vw, 92px); line-height: .92; letter-spacing: -.04em; color: #fbf7ff; margin: 22px 0 28px; text-wrap: balance; }
  .topo h1 em { font-style: normal; color: var(--lc-peach); }
  .lead { color: rgba(255,255,255,.76); margin: 0 0 32px; }
  .form { display: flex; gap: 10px; max-width: 540px; }
  .form .input { flex: 1; height: 54px; background: transparent; border-color: rgba(255,255,255,.3); color: #fff; }
  .form .input::placeholder { color: rgba(255,255,255,.55); }
  .form .btn { height: 54px; padding-inline: 28px; }
  .aviso { margin: 14px 0 0; font-size: 13.5px; color: rgba(255,255,255,.6); }

  .guia { transform: rotate(3deg); background: #fbf7ff; border-radius: 3px; overflow: hidden; box-shadow: 0 50px 70px -34px rgba(0,0,0,.8); transition: transform 400ms var(--ease-spring); }
  .guia:hover { transform: rotate(1deg) translateY(-6px); }
  .guia-capa { aspect-ratio: 1; }
  .guia-corpo { padding: 20px 24px 26px; display: flex; flex-direction: column; gap: 10px; }
  .guia-corpo b { font-family: var(--font-display); font-size: 34px; line-height: 1; letter-spacing: -1px; color: var(--dvb-ink); }
  .guia-corpo span { font-size: 14px; color: var(--dvb-ink-3); }

  .esperar { padding-block: 96px 112px; }
  .esperar h2 { font-size: clamp(34px, 4vw, 52px); letter-spacing: -.035em; margin: 0 0 44px; }
  .itens { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .itens li { border-top: 2px solid var(--dvb-ink); padding-top: 28px; }
  .itens h3 { font-size: 27px; letter-spacing: -.6px; margin: 22px 0 10px; }
  .itens p { font-size: 16px; line-height: 1.55; color: var(--dvb-ink-2); margin: 0; }

  @media (max-width: 1000px) {
    .topo { grid-template-columns: 1fr; gap: 48px; padding-block: 48px 64px; }
    .guia { max-width: 340px; }
    .itens { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .form { flex-direction: column; }
    .itens { grid-template-columns: 1fr; gap: 28px; }
    .esperar { padding-block: 56px 72px; }
  }
</style>
