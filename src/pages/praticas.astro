---
import BaseLayout from '../layouts/BaseLayout.astro';
import AutorNome from '../components/AutorNome.astro';
import { getSecaoLabel } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(post => post.data.secao === 'praticas' && !post.data.rascunho)
  .sort((a, b) => new Date(b.data.publicado_em).getTime() - new Date(a.data.publicado_em).getTime());

const formatarData = (date: Date): string => {
  return new Intl.DateTimeFormat('pt-BR', {
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
};
---

<BaseLayout title="Práticas" description="Técnicas, ferramentas e tutoriais de visualização de dados.">
  <section class="section-page">
    <div class="container">
      <header class="section-header">
        <h1>Práticas</h1>
        <p class="section-subtitle">Princípios, técnicas, ferramentas e tutoriais</p>
      </header>

      <div class="posts-grid">
        {posts.map((post) => (
          <article class="post-card">
            {post.data.capa ? (
              <img src={post.data.capa.src} alt={post.data.capa_alt || post.data.titulo} class="post-thumb" />
            ) : (
              <div class="post-thumb post-thumb-placeholder" aria-hidden="true"></div>
            )}
            <div class="post-card-body">
              <div class="post-meta">
                <span class={`badge badge-${post.data.secao}`}>{getSecaoLabel(post.data.secao)}</span>
              </div>
              <h2 class="post-titulo">
                <a href={`/posts/${post.id}`}>{post.data.titulo}</a>
              </h2>
              {post.data.descricao && (
                <p class="post-excerpt">{post.data.descricao}</p>
              )}
              <div class="post-foot">
                <span><AutorNome autorId={post.data.autores[0]?.id} /></span>
                <span class="dot"></span>
                <span>{formatarData(post.data.publicado_em)}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-page {
    padding-block: var(--space-40);
    border-bottom: 1px solid var(--border-default);
  }

  .section-header {
    margin-bottom: var(--space-32);
    max-width: 800px;
  }

  .section-header h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
    color: var(--fg-heading);
    margin-bottom: var(--space-6);
  }

  .section-subtitle {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--fg-body);
    margin: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-12);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-relaxed);
    overflow: hidden;
    transition: box-shadow 160ms ease;
  }

  .post-card:hover {
    box-shadow: var(--elev-2);
  }

  .post-thumb {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
  }

  .post-thumb-placeholder {
    background: linear-gradient(135deg, var(--dvb-ink-3) 0%, var(--dvb-ink-2) 100%);
  }

  .post-card-body {
    padding: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    flex: 1;
  }

  .post-meta {
    margin: 0;
  }

  .post-titulo {
    font-size: var(--fs-body-lg);
    font-weight: 700;
    line-height: var(--lh-h4);
    letter-spacing: var(--ls-h4);
    color: var(--fg-heading);
    margin: 0;
  }

  .post-titulo a {
    color: inherit;
    border-bottom: none;
  }

  .post-titulo a:hover {
    color: var(--color-primary);
  }

  .post-excerpt {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--fg-body);
    margin: 0;
    flex: 1;
  }

  .post-foot {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--fg-meta);
    margin: 0;
  }

  .dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    background: var(--fg-meta);
    border-radius: 50%;
  }

  @media (max-width: 900px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
