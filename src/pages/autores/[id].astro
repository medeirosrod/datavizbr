---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPostsPorAutor, getLivrosPorAutor, papelNoLivro } from '../../lib/data';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const autores = (await getCollection('autores')).filter(autor => autor.data.ativo);
  return autores.map(autor => ({
    params: { id: autor.id },
    props: { autor },
  }));
}

interface Props {
  autor: any;
}

const { autor } = Astro.props;

const posts = await getPostsPorAutor(autor.id);
const livros = await getLivrosPorAutor(autor.id);

const papelLabel: Record<string, string> = {
  curadoria: 'Curadoria',
  recorrente: 'Autor recorrente',
  convidado: 'Autor convidado',
};

const desde = autor.data.desde
  ? new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(autor.data.desde))
  : undefined;
const redes = [
  autor.data.site && { rotulo: 'Site', href: autor.data.site },
  autor.data.twitter && { rotulo: 'Twitter', href: `https://twitter.com/${autor.data.twitter}` },
  autor.data.instagram && { rotulo: 'Instagram', href: `https://instagram.com/${autor.data.instagram}` },
  autor.data.linkedin && { rotulo: 'LinkedIn', href: autor.data.linkedin },
].filter(Boolean) as { rotulo: string; href: string }[];
---

<BaseLayout title={autor.data.nome} description={autor.data.quem_e} tema="escuro">
  <header class="topo-pag grao">
    <div class="container cab">
      <div>
        <span class="eyebrow">{papelLabel[autor.data.papel] || autor.data.papel}{desde ? `, escreve desde ${desde}` : ''}</span>
        <h1>{autor.data.nome}</h1>
        <p class="apoio-mono lead">{autor.data.quem_e}</p>
        {redes.length > 0 && (
          <div class="redes">
            {redes.map((r) => <a class="btn btn-outline" href={r.href} target="_blank" rel="noopener noreferrer">{r.rotulo}</a>)}
          </div>
        )}
      </div>
      {autor.data.foto && (
        <div class="retrato"><img src={autor.data.foto.src} alt={autor.data.nome} /></div>
      )}
    </div>
  </header>

  <div class="container pagina">
    {(autor.data.trabalhando_em || autor.data.trabalho_favorito || autor.data.por_que_escreveu) && (
      <dl class="ficha">
        {autor.data.trabalhando_em && <div><dt>Trabalhando em</dt><dd>{autor.data.trabalhando_em}</dd></div>}
        {autor.data.trabalho_favorito && (
          <div><dt>Trabalho favorito</dt><dd><a href={autor.data.trabalho_favorito.url} target="_blank" rel="noopener noreferrer">{autor.data.trabalho_favorito.titulo}</a></dd></div>
        )}
        {autor.data.por_que_escreveu && <div><dt>Por que escreveu</dt><dd>{autor.data.por_que_escreveu}</dd></div>}
      </dl>
    )}

    {posts.length > 0 && (
      <section aria-labelledby="textos">
        <h2 id="textos" class="titulo-bloco">{`${posts.length} ${posts.length === 1 ? 'texto publicado' : 'textos publicados'}`}</h2>
        <div class="grade">
          {posts.map((post, i) => <PostCard post={post} indice={i} />)}
        </div>
      </section>
    )}

    {livros.length > 0 && (
      <section aria-labelledby="livros">
        <h2 id="livros" class="titulo-bloco">{livros.length === 1 ? 'Livro' : 'Livros'}</h2>
        <div class="livros">
          {livros.map((livro) => {
            const papel = papelNoLivro(livro, autor.id);
            return (
              <a href={`/livros/${livro.id}`} class="livro">
                <img src={livro.data.capa.src} alt={livro.data.capa_alt} />
                <span class="mono">{papel === 'organizador' ? 'Organizador' : 'Autor de capítulo'}</span>
                <b>{livro.data.titulo}</b>
                <small>{livro.data.ano}</small>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .cab { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 72px; align-items: center; padding-block: 64px 72px; }
  .cab h1 { font-size: clamp(44px, 7.4vw, 104px); line-height: .92; letter-spacing: -.0126em; color: #fbf7ff; margin: 20px 0 26px; text-wrap: balance; }
  .lead { color: rgba(255,255,255,.76); max-width: 54ch; margin: 0; }
  .redes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .redes .btn-outline { color: #fbf7ff; }
  .retrato { display: grid; place-items: center; aspect-ratio: 1; border-radius: 3px; background: linear-gradient(to bottom, #d0701d, var(--lc-clay)); box-shadow: 0 40px 60px -30px rgba(0,0,0,.7); }
  .retrato img { width: 76%; height: 76%; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 4px #8a4210; }

  .pagina { padding-block: 64px 96px; }
  .ficha { margin: 0 0 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px 40px; }
  .ficha > div { padding-top: 14px; border-top: 1px solid var(--lc-hairline); font-size: 15.5px; line-height: 1.5; color: var(--dvb-ink-2); }
  .ficha dt { font-size: 12px; font-weight: 600; color: var(--fg-meta); margin-bottom: 4px; }
  .ficha dd { margin: 0; }
  .ficha a { color: var(--lc-ink-orange); border-bottom: 1px solid currentColor; }
  .titulo-bloco { font-size: clamp(30px, 3.4vw, 40px); letter-spacing: -.0105em; margin: 56px 0 32px; }
  .grade { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 32px; }
  .livros { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 32px; }
  .livro { display: flex; flex-direction: column; gap: 6px; color: inherit; border-bottom: 0; }
  .livro img { width: 100%; height: auto; border-radius: 3px; box-shadow: 0 0 0 1px var(--lc-hairline), 0 24px 34px -24px rgba(42,22,64,.5); transition: transform 240ms var(--ease-out); }
  .livro:hover img { transform: translateY(-4px); }
  .livro .mono { font-size: 12px; color: var(--lc-ink-orange); margin-top: 10px; }
  .livro b { font-family: var(--font-display); font-size: 22px; letter-spacing: -.5px; line-height: 1.1; color: var(--dvb-ink); }
  .livro small { font-size: 13.5px; color: var(--fg-meta); }

  @media (max-width: 1000px) {
    .cab { grid-template-columns: 1fr; gap: 36px; padding-block: 40px 48px; }
    .retrato { max-width: 260px; order: -1; }
    .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) { .grade { grid-template-columns: 1fr; } .pagina { padding-block: 40px 64px; } }
</style>
