<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7.8.5/dist/d3.min.js"></script>

<script is:inline>
  // Importar função de inicialização
  function initAnimations() {
    // Scroll Progress
    const scrollBar = document.getElementById('scrollProgress');
    if (scrollBar) {
      window.addEventListener('scroll', () => {
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = (window.scrollY / scrollHeight) * 100;
        scrollBar.style.width = scrolled + '%';
      });
    }

    // Nav Scroll
    const nav = document.getElementById('nav');
    if (nav) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          nav.classList.add('nav-scrolled');
        } else {
          nav.classList.remove('nav-scrolled');
        }
      });
    }

    // Reveal Animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Stagger children
    document.querySelectorAll('.stagger-children').forEach(container => {
      Array.from(container.children).forEach((child, i) => {
        child.style.setProperty('--stagger-index', String(i));
      });
      observer.observe(container);
    });

    // Split Words
    if (typeof gsap !== 'undefined') {
      document.querySelectorAll('[data-anim="split-words"]').forEach(el => {
        const text = el.textContent;
        const words = text?.split(' ') || [];
        el.innerHTML = words.map(w =>
          `<span class="word-wrapper"><span class="word">${w}</span></span>`
        ).join(' ');

        gsap.from(el.querySelectorAll('.word'), {
          opacity: 0,
          y: '100%',
          duration: 0.8,
          stagger: 0.04,
          ease: 'power3.out',
        });
      });
    }

    // Render chart
    if (typeof window.renderChart === 'function') {
      window.renderChart();
    }
  }

  // Inicializar
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations);
  } else {
    initAnimations();
  }
</script>
