---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroChart from '../components/HeroChart.astro';
import AutorNome from '../components/AutorNome.astro';
import { getSecaoLabel } from '../consts';
import { getCollection } from 'astro:content';

// Buscar todos os posts não arquivados e não em rascunho, ordenados por data
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(post => !post.data.rascunho && !post.data.arquivo)
  .sort((a, b) => new Date(b.data.publicado_em).getTime() - new Date(a.data.publicado_em).getTime());

// Post em destaque (primeiro com destaque=true, ou o mais recente)
const featured = posts.find(p => p.data.destaque) || posts[0];
const recentPosts = posts.slice(1, 5);

// Posts por seção
const postsPorSecao = {
  bastidores: posts.filter(p => p.data.secao === 'bastidores').slice(0, 3),
  panorama: posts.filter(p => p.data.secao === 'panorama').slice(0, 3),
  praticas: posts.filter(p => p.data.secao === 'praticas').slice(0, 3),
  ensaios: posts.filter(p => p.data.secao === 'ensaios').slice(0, 3),
};

const contagemPorSecao = {
  bastidores: posts.filter(p => p.data.secao === 'bastidores').length,
  panorama: posts.filter(p => p.data.secao === 'panorama').length,
  praticas: posts.filter(p => p.data.secao === 'praticas').length,
  ensaios: posts.filter(p => p.data.secao === 'ensaios').length,
};

// Buscar séries
const allSeries = await getCollection('series');
const series = allSeries.sort((a, b) => new Date(b.data.iniciada_em).getTime() - new Date(a.data.iniciada_em).getTime()).slice(0, 2);

// Função auxiliar para formatar data
const formatarData = (date: Date): string => {
  return new Intl.DateTimeFormat('pt-BR', {
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
};

// Função para calcular tempo de leitura (estimativa simples)
const tempoLeitura = (slug: string): number => {
  // Aproximadamente 200 palavras por minuto
  const wordsPerMinute = 200;
  // Isso é uma aproximação - em produção você teria o conteúdo real
  return Math.ceil(3); // placeholder
};
---

<BaseLayout>

  <!-- ═══════════════════════════════════════════
       BLOCO 1 — IDENTIDADE + GRÁFICO D3
  ════════════════════════════════════════════ -->
  <header class="hero">
    <div class="container">
      <div class="hero-grid">
        <!-- COLUNA ESQUERDA — TEXTO -->
        <div class="hero-text">
          <p class="t-eyebrow hero-eyebrow reveal">Visualização de dados · Em português · Desde 2017</p>
          <h1 class="hero-title" data-anim="split-words">
            Bastidores, panorama, práticas e ensaios sobre dataviz no Brasil.
          </h1>
          <p class="hero-lead reveal">
            O datavizbr reúne quem faz, pesquisa e escreve sobre visualização de dados em português —
            making-ofs, mapeamentos da cena brasileira e reflexões sobre o campo.
          </p>
        </div>

        <!-- COLUNA DIREITA — GRÁFICO D3.JS -->
        <HeroChart />
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════
       BLOCO 2 — EM DESTAQUE
  ════════════════════════════════════════════ -->
  {featured && (
    <section class="section destaque-section">
      <div class="container">
        <div class="section-head">
          <h2>Em destaque</h2>
        </div>
        <article class="destaque">
          <div class="destaque-capa">
            {featured.data.capa ? (
              <img src={featured.data.capa.src} alt={featured.data.capa_alt || featured.data.titulo} />
            ) : (
              <div class="destaque-capa-placeholder" aria-hidden="true"></div>
            )}
          </div>
          <div class="destaque-conteudo">
            <div class="destaque-meta">
              <span class={`badge badge-${featured.data.secao}`}>{getSecaoLabel(featured.data.secao)}</span>
              <span class="t-caption">{tempoLeitura(featured.slug)} min de leitura</span>
            </div>
            <h2 class="destaque-titulo">
              <a href={`/posts/${featured.id}`}>
                {featured.data.titulo}
              </a>
            </h2>
            <p class="destaque-excerpt">
              {featured.data.descricao || featured.data.subtitulo}
            </p>
            <div class="destaque-autor">
              <div class="autor-avatar" aria-hidden="true">{featured.data.autores[0]?.id?.substring(0, 2).toUpperCase() || 'DR'}</div>
              <div>
                <div class="autor-nome"><AutorNome autorId={featured.data.autores[0]?.id} /></div>
                <div class="t-caption">{formatarData(featured.data.publicado_em)}</div>
              </div>
            </div>
            <a href={`/posts/${featured.id}`} class="destaque-cta">
              Ler texto →
            </a>
          </div>
        </article>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════
       BLOCO 3 — ÚLTIMOS POSTS
  ════════════════════════════════════════════ -->
  <section class="section ultimos-section">
    <div class="container">
      <div class="section-head">
        <h2>Recentes</h2>
        <a href="/arquivo" class="section-head-link">Ver arquivo completo →</a>
      </div>
      <div class="posts-grid stagger-children">
        {recentPosts.map((post, idx) => (
          <article class="post-card" style={`--stagger-index: ${idx}`}>
            {post.data.capa ? (
              <img src={post.data.capa.src} alt={post.data.capa_alt || post.data.titulo} class="post-thumb" />
            ) : (
              <div class="post-thumb post-thumb-placeholder" aria-hidden="true"></div>
            )}
            <div class="post-card-body">
              <div class="post-meta"><span class={`badge badge-${post.data.secao}`}>{getSecaoLabel(post.data.secao)}</span></div>
              <h3 class="post-titulo">
                <a href={`/posts/${post.id}`}>{post.data.titulo}</a>
              </h3>
              <p class="post-excerpt">
                {post.data.descricao || post.data.subtitulo}
              </p>
              <div class="post-foot">
                <span><AutorNome autorId={post.data.autores[0]?.id} /></span><span class="dot"></span><span>{formatarData(post.data.publicado_em)}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       BLOCO 4 — NAVEGUE POR SEÇÃO
  ════════════════════════════════════════════ -->
  <section class="acervo-section">
    <div class="container">
      <div class="acervo-header">
        <div>
          <p class="t-eyebrow acervo-eyebrow">Acervo desde 2017</p>
          <h2 class="acervo-titulo">Navegue pelo acervo</h2>
        </div>
        <p class="acervo-subtitulo">Quatro seções, uma comunidade.</p>
      </div>

      <div class="acervo-grid">

        <a href="/bastidores" class="acervo-card acervo-card--bastidores">
          <div class="acervo-card-bg" aria-hidden="true"></div>
          <div class="acervo-card-inner">
            <div class="acervo-card-top">
              <span class="acervo-card-num">{String(contagemPorSecao.bastidores).padStart(2, '0')}</span>
              <span class="acervo-card-tag">Making-ofs</span>
            </div>
            <div class="acervo-card-mid">
              <h3 class="acervo-card-nome">Bastidores</h3>
              <p class="acervo-card-desc">
                Como uma visualização foi feita — processo, decisões e ferramentas em primeira pessoa.
              </p>
            </div>
            <ul class="acervo-card-lista">
              {postsPorSecao.bastidores.map((post) => (
                <li>
                  <span class="acervo-lista-bullet" aria-hidden="true">→</span>
                  <span class="acervo-lista-titulo">{post.data.titulo}</span>
                </li>
              ))}
            </ul>
            <span class="acervo-card-cta">Explorar seção →</span>
          </div>
        </a>

        <a href="/panorama" class="acervo-card acervo-card--panorama">
          <div class="acervo-card-bg" aria-hidden="true"></div>
          <div class="acervo-card-inner">
            <div class="acervo-card-top">
              <span class="acervo-card-num">{String(contagemPorSecao.panorama).padStart(2, '0')}</span>
              <span class="acervo-card-tag">Mapeamentos</span>
            </div>
            <div class="acervo-card-mid">
              <h3 class="acervo-card-nome">Panorama</h3>
              <p class="acervo-card-desc">
                Quem faz, o que está acontecendo, quem ganhou o quê na cena brasileira.
              </p>
            </div>
            <ul class="acervo-card-lista">
              {postsPorSecao.panorama.map((post) => (
                <li>
                  <span class="acervo-lista-bullet" aria-hidden="true">→</span>
                  <span class="acervo-lista-titulo">{post.data.titulo}</span>
                </li>
              ))}
            </ul>
            <span class="acervo-card-cta">Explorar seção →</span>
          </div>
        </a>

        <a href="/praticas" class="acervo-card acervo-card--praticas">
          <div class="acervo-card-bg" aria-hidden="true"></div>
          <div class="acervo-card-inner">
            <div class="acervo-card-top">
              <span class="acervo-card-num">{String(contagemPorSecao.praticas).padStart(2, '0')}</span>
              <span class="acervo-card-tag">Técnicas</span>
            </div>
            <div class="acervo-card-mid">
              <h3 class="acervo-card-nome">Práticas</h3>
              <p class="acervo-card-desc">
                Princípios, ferramentas e tutoriais aplicáveis — de acessibilidade a software.
              </p>
            </div>
            <ul class="acervo-card-lista">
              {postsPorSecao.praticas.map((post) => (
                <li>
                  <span class="acervo-lista-bullet" aria-hidden="true">→</span>
                  <span class="acervo-lista-titulo">{post.data.titulo}</span>
                </li>
              ))}
            </ul>
            <span class="acervo-card-cta">Explorar seção →</span>
          </div>
        </a>

        <a href="/ensaios" class="acervo-card acervo-card--ensaios">
          <div class="acervo-card-bg" aria-hidden="true"></div>
          <div class="acervo-card-inner">
            <div class="acervo-card-top">
              <span class="acervo-card-num">{String(contagemPorSecao.ensaios).padStart(2, '0')}</span>
              <span class="acervo-card-tag">Reflexões</span>
            </div>
            <div class="acervo-card-mid">
              <h3 class="acervo-card-nome">Ensaios</h3>
              <p class="acervo-card-desc">
                O papel da dataviz, ética, futuro e posicionamento no campo.
              </p>
            </div>
            <ul class="acervo-card-lista">
              {postsPorSecao.ensaios.map((post) => (
                <li>
                  <span class="acervo-lista-bullet" aria-hidden="true">→</span>
                  <span class="acervo-lista-titulo">{post.data.titulo}</span>
                </li>
              ))}
            </ul>
            <span class="acervo-card-cta">Explorar seção →</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       BLOCO 5 — SÉRIES
  ════════════════════════════════════════════ -->
  <section class="section series-section">
    <div class="container">
      <div class="section-head">
        <h2>Séries</h2>
        <a href="/series" class="section-head-link">Ver todas →</a>
      </div>
      <div class="series-grid stagger-children">
        {series.map((serie, idx) => {
          const statusText = serie.data.status === 'encerrada' ? 'Encerrada' : 'Em andamento';
          const postsDaSerie = allPosts.filter(p => p.data.serie?.id === serie.id);
          const corClass = serie.data.cor ? `serie-capa-${serie.data.cor}` : 'serie-capa-laranja';
          return (
            <a href={`/series/${serie.id}`} class="serie-card" style={`--stagger-index: ${idx}`}>
              {serie.data.capa ? (
                <img src={serie.data.capa.src} alt={serie.data.titulo} class="serie-card-capa" />
              ) : (
                <div class={`serie-card-capa ${corClass}`} aria-hidden="true"></div>
              )}
              <div class="serie-card-body">
                <div class="serie-card-meta">
                  <span class="badge badge-serie">Série</span>
                  <span class="t-caption">{statusText} · {postsDaSerie.length} {postsDaSerie.length === 1 ? 'parte' : 'partes'}</span>
                </div>
                <h3 class="serie-card-titulo">{serie.data.titulo}</h3>
                <p class="serie-card-descricao">
                  {serie.data.descricao}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       BLOCO 6 — SOBRE + NEWSLETTER
  ════════════════════════════════════════════ -->
  <section class="sobre-newsletter">
    <div class="container sobre-newsletter-inner">

      <div class="sobre-bloco">
        <p class="t-eyebrow">O projeto</p>
        <h2 class="sobre-titulo">Dataviz em português, desde 2017.</h2>
        <p class="sobre-texto">
          O datavizbr nasceu como espaço pra compartilhar experiências sobre
          visualização de dados em português. Ao longo dos anos reuniu autores
          convidados, séries temáticas e, em 2023, organizou o livro
          <em>Dataviz em perspectiva</em> com Júlia Giannella.
        </p>
        <a href="/sobre" class="btn btn-quiet">Conheça o projeto →</a>
      </div>

      <div class="newsletter-bloco">
        <p class="t-eyebrow">Newsletter</p>
        <h2 class="newsletter-titulo">Uma vez por mês, no seu email.</h2>
        <p class="newsletter-texto">
          No primeiro domingo do mês, uma curadoria do que rolou na cena
          brasileira de dataviz — sem spam, sem patrocínio.
        </p>
        <form class="newsletter-form" onsubmit="return false;">
          <input
            class="input"
            type="email"
            placeholder="seu@email.com"
            aria-label="Seu endereço de email"
          />
          <button class="btn btn-primary" type="submit">Inscrever</button>
        </form>
        <p class="newsletter-disclaimer t-caption">
          Você pode cancelar a qualquer momento.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO GRID ──────────────────────────────── */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-24);
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .hero-eyebrow {
    margin-bottom: var(--space-8);
  }

  .hero-title {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
    color: var(--fg-heading);
    margin: 0;
  }

  .hero-lead {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--fg-body);
    margin: 0;
  }

  /* ── UTILITÁRIOS ────────────────────────────── */
  .section {
    padding-block: var(--space-40);
    border-bottom: 1px solid var(--border-default);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-16);
  }
  .section-head-link {
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--fg-meta);
    border-bottom: none;
  }
  .section-head-link:hover { color: var(--color-primary); }

  /* ── HERO ───────────────────────────────────── */
  .hero {
    padding-block: var(--space-40) var(--space-32);
    border-bottom: 1px solid var(--border-default);
  }
  .hero-eyebrow { margin-bottom: var(--space-8); }
  .hero-title {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
    color: var(--fg-heading);
    max-width: 760px;
    margin-bottom: var(--space-8);
  }
  .hero-lead {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--fg-body);
    max-width: 580px;
  }

  /* ── DESTAQUE ───────────────────────────────── */
  .destaque {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-20);
    align-items: center;
  }
  .destaque-capa-placeholder {
    aspect-ratio: 4/3;
    border-radius: var(--radius-large);
    background: linear-gradient(135deg, var(--dvb-orange-100) 0%, var(--dvb-purple-100) 100%);
    box-shadow: var(--elev-3);
  }
  .destaque-meta {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    margin-bottom: var(--space-7);
  }
  .destaque-titulo {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    font-weight: 700;
    color: var(--fg-heading);
    margin-bottom: var(--space-8);
  }
  .destaque-titulo a {
    color: inherit;
    border-bottom: none;
  }
  .destaque-titulo a:hover { color: var(--color-primary); }
  .destaque-excerpt {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--fg-body);
    margin-bottom: var(--space-10);
  }
  .destaque-autor {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    margin-bottom: var(--space-10);
  }
  .autor-avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--dvb-orange), var(--dvb-purple));
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: var(--fs-micro);
    flex-shrink: 0;
  }
  .autor-nome {
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--fg-heading);
  }
  .destaque-cta {
    display: inline-block;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-primary);
    border-bottom: none;
  }
  .destaque-cta:hover { color: var(--color-primary-hover); }

  /* ── GRID DE POSTS ──────────────────────────── */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-12);
  }
  .post-card { display: flex; flex-direction: column; }
  .post-thumb {
    aspect-ratio: 16/10;
    border-radius: var(--radius-relaxed);
    border: 1px solid var(--border-default);
    overflow: hidden;
    margin-bottom: var(--space-7);
    transition: box-shadow 160ms ease;
  }
  .post-thumb-placeholder { background: var(--bg-soft); }
  .post-card:hover .post-thumb { box-shadow: var(--elev-2); }
  .post-card-body { display: flex; flex-direction: column; flex: 1; gap: var(--space-3); }
  .post-meta { margin-bottom: var(--space-2); }
  .post-titulo {
    font-size: var(--fs-body-lg);
    font-weight: 700;
    line-height: var(--lh-h4);
    letter-spacing: var(--ls-h4);
    color: var(--fg-heading);
  }
  .post-titulo a { color: inherit; border-bottom: none; }
  .post-titulo a:hover { color: var(--color-primary); }
  .post-excerpt {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--fg-body);
    flex: 1;
  }
  .post-foot {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--fg-meta);
    margin-top: var(--space-4);
  }

  /* ── ACERVO (redesign) ─────────────────────── */
  .acervo-section {
    padding-block: var(--space-48) var(--space-48);
    background: var(--dvb-ink);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .acervo-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-20);
    gap: var(--space-12);
  }
  .acervo-eyebrow {
    color: rgba(255,255,255,0.45);
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    font-size: var(--fs-micro);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }
  .acervo-titulo {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    font-weight: 700;
    color: #fff;
    margin: 0;
  }
  .acervo-subtitulo {
    font-size: var(--fs-body-lg);
    color: rgba(255,255,255,0.45);
    margin: 0;
    max-width: 220px;
    text-align: right;
    line-height: 1.4;
  }

  .acervo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .acervo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-large);
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    text-decoration: none;
    color: inherit;
    min-height: 420px;
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }
  .acervo-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px rgba(0,0,0,0.4);
    border-color: rgba(255,255,255,0.18);
    color: inherit;
  }

  /* fundo decorativo com gradiente de cor */
  .acervo-card-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 220ms ease;
    pointer-events: none;
    z-index: 0;
  }
  .acervo-card:hover .acervo-card-bg { opacity: 1; }

  .acervo-card--bastidores { background: #1f1028; }
  .acervo-card--bastidores .acervo-card-bg {
    background: linear-gradient(160deg, rgba(230,126,44,0.15) 0%, transparent 60%);
  }
  .acervo-card--bastidores .acervo-card-num { color: var(--dvb-orange); }
  .acervo-card--bastidores .acervo-card-nome { color: var(--dvb-orange-300); }
