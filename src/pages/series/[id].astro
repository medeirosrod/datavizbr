---
import { render } from 'astro:content';
import SeriePadrao from '../../components/series/SeriePadrao.astro';
import SerieDestaque from '../../components/series/SerieDestaque.astro';
import { getPostsPorSerie, getSeries } from '../../lib/data';

export async function getStaticPaths() {
  const series = await getSeries();

  return series.map((serie) => ({
    params: { id: serie.id },
    props: { serie },
  }));
}

interface Props {
  serie: any;
}

const { serie } = Astro.props;
const postsDaSerie = await getPostsPorSerie(serie.id);
const { Content } = await render(serie);

// cada série escolhe o seu layout no frontmatter (`layout: destaque`); sem o campo, vale o padrão
const Layout = serie.data.layout === 'destaque' ? SerieDestaque : SeriePadrao;
---

<Layout serie={serie} postsDaSerie={postsDaSerie}>
  <Content />
</Layout>
