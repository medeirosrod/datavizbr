---
// Arquivo: todos os textos. A faixa de aberturas serve de mapa; a lista agrupa por ano.
import BaseLayout from '../layouts/BaseLayout.astro';
import Faixa from '../components/Faixa.astro';
import Selo from '../components/Selo.astro';
import AutorNome from '../components/AutorNome.astro';
import { ehDeSerieCategoria, getPosts, getSeriesCategoria, porData, rotuloCategoria } from '../lib/data';
import { formaD, SECOES, type Secao } from '../lib/formas';

const categorias = await getSeriesCategoria();
const recentes = (await getPosts()).sort(porData); // do mais recente ao mais antigo
const antigos = [...recentes].reverse();
const anoDe = (p: (typeof recentes)[number]) => new Date(p.data.publicado_em).getUTCFullYear();
const mesDe = new Intl.DateTimeFormat('pt-BR', { month: 'long', timeZone: 'UTC' });

const grupos = new Map<number, typeof recentes>();
recentes.forEach((p) => grupos.set(anoDe(p), [...(grupos.get(anoDe(p)) ?? []), p]));
const anos = [...grupos.keys()];
const contagem = Object.fromEntries(SECOES.map((s) => [s, recentes.filter((p) => p.data.secao === s && !ehDeSerieCategoria(p, categorias)).length]));
---

<BaseLayout title="Arquivo" description="Todos os textos publicados no datavizbr, de 2016 até hoje." tema="escuro">
  <header class="topo-pag grao">
    <div class="container">
      <div class="cab">
        <h1>Arquivo</h1>
        <p class="apoio-mono lead">Os {recentes.length} textos do datavizbr, de {anoDe(antigos[0])} a {anoDe(recentes[0])}. A parede serve de mapa: toque numa abertura para ir ao texto.</p>
      </div>
      <Faixa posts={antigos} id="faixa-arquivo" colunas={25} fechados={2} />
      <div class="linha-t mono">
        <span>{anoDe(antigos[0])}</span>
        <span class="so-desktop">ordem de publicação, da esquerda para a direita</span>
        <span>{anoDe(recentes[0])}</span>
      </div>
    </div>
  </header>

  <div class="container pagina">
    <div class="barra-filtro" role="group" aria-label="Filtrar textos">
      <div class="chips">
        <button type="button" class="chip" data-secao="todos" aria-pressed="true">Todos {recentes.length}</button>
        {SECOES.map((s) => (
          <button type="button" class="chip" data-secao={s} aria-pressed="false">
            <Selo secao={s} tamanho={15} />
          </button>
        ))}
        <button type="button" class="chip" id="ordem" aria-pressed="false">Mais recentes primeiro</button>
      </div>
      <label class="sr" for="busca-arquivo">Buscar por título, autor ou tema</label>
      <input id="busca-arquivo" class="input busca" type="search" placeholder="Buscar por título, autor ou tema" autocomplete="off" />
    </div>

    <div id="anos">
      {anos.map((ano) => {
        const lista = grupos.get(ano)!;
        return (
          <section class="ano" data-ano={ano}>
            <div class="ano-cab">
              <h2>{ano}</h2>
              <p class="mono ano-n"><span class="n">{lista.length}</span> textos</p>
              <div class="mini-glifos" aria-hidden="true">
                {lista.map((p) => (
                  <svg data-id={p.id} viewBox="0 0 80 80"><rect width="80" height="80" rx="6" fill="#24142f" /><path d={formaD(p.data.secao as Secao)} fill="#f4b07a" /></svg>
                ))}
              </div>
            </div>
            <ul class="linhas">
              {lista.map((p) => (
                <li
                  data-id={p.id}
                  data-secao={ehDeSerieCategoria(p, categorias) ? 'serie' : p.data.secao}
                  data-busca={`${p.data.titulo} ${p.data.descricao ?? ''} ${p.data.autores.map((a) => a.id).join(' ')} ${(p.data.tags ?? []).join(' ')}`.toLowerCase()}
                >
                  <a class="linha" href={`/posts/${p.id}`}>
                    <span class="linha-selo"><Selo secao={p.data.secao as Secao} semNome tamanho={18} /><span class="sr">{rotuloCategoria(p, categorias)}</span></span>
                    <span class="linha-titulo">{p.data.titulo}</span>
                    <span class="linha-autor"><AutorNome autorId={p.data.autores[0]?.id} /></span>
                    <span class="linha-mes mono">{mesDe.format(new Date(p.data.publicado_em))}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
    <p class="vazio" id="vazio" hidden>Nenhum texto encontrado.</p>

    <div class="mais">
      <button type="button" class="btn btn-quiet" id="mais" hidden></button>
      <span class="mono estado" id="estado" aria-live="polite"></span>
    </div>
  </div>
</BaseLayout>

<script>
  const MIN_VISIVEIS = 25;
  const raiz = document.getElementById('anos')!;
  const grupos = () => [...raiz.querySelectorAll<HTMLElement>('.ano')];
  const mais = document.getElementById('mais') as HTMLButtonElement;
  const estado = document.getElementById('estado')!;
  const vazio = document.getElementById('vazio')!;
  const busca = document.getElementById('busca-arquivo') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip[data-secao]')];
  const ordem = document.getElementById('ordem') as HTMLButtonElement;

  let secao = 'todos';
  let termo = '';
  let antigoPrimeiro = false;
  let tudo = false;

  function desenhar() {
    const filtrando = secao !== 'todos' || termo !== '';
    let acumulado = 0;
    let visiveis = 0;
    let escondidos = 0;

    grupos().forEach((g) => {
      const itens = [...g.querySelectorAll<HTMLElement>('li')];
      const casados = itens.filter(
        (li) => (secao === 'todos' || li.dataset.secao === secao) && (!termo || li.dataset.busca!.includes(termo)),
      );
      itens.forEach((li) => (li.hidden = !casados.includes(li)));
      g.querySelectorAll<SVGElement>('.mini-glifos svg').forEach((s) => {
        s.style.display = casados.some((li) => li.dataset.id === s.dataset.id) ? '' : 'none';
      });
      g.querySelector('.n')!.textContent = String(casados.length);

      // Sem filtro, só os anos mais recentes aparecem até o botão "Mostrar".
      const cabe = filtrando || tudo || acumulado < MIN_VISIVEIS;
      g.hidden = casados.length === 0 || !cabe;
      if (casados.length) {
        if (cabe) visiveis += casados.length;
        else escondidos += casados.length;
        acumulado += casados.length;
      }
    });

    vazio.hidden = visiveis + escondidos > 0;
    mais.hidden = escondidos === 0;
    if (escondidos) {
      const ocultos = grupos().filter((g) => g.hidden && g.querySelector('li:not([hidden])'));
      const anos = ocultos.map((g) => g.dataset.ano!);
      mais.textContent = `Mostrar ${anos[0]} a ${anos[anos.length - 1]}`;
    }
    estado.textContent = visiveis + escondidos ? `${visiveis} de ${visiveis + escondidos} textos` : '';
  }

  function ordenar() {
    // Anos trocam de posição; a ordem padrão é do mais recente ao mais antigo.
    grupos()
      .sort((a, b) => (Number(a.dataset.ano) - Number(b.dataset.ano)) * (antigoPrimeiro ? 1 : -1))
      .forEach((g) => raiz.appendChild(g));
  }

  function inverterDentro() {
    grupos().forEach((g) => {
      const ul = g.querySelector('ul')!;
      [...ul.children].reverse().forEach((li) => ul.appendChild(li));
      const mini = g.querySelector('.mini-glifos')!;
      [...mini.children].reverse().forEach((s) => mini.appendChild(s));
    });
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      secao = chip.dataset.secao!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      desenhar();
    }),
  );
  busca.addEventListener('input', () => { termo = busca.value.trim().toLowerCase(); desenhar(); });
  mais.addEventListener('click', () => { tudo = true; desenhar(); });
  ordem.addEventListener('click', () => {
    antigoPrimeiro = !antigoPrimeiro;
    ordem.setAttribute('aria-pressed', String(antigoPrimeiro));
    ordem.textContent = antigoPrimeiro ? 'Mais antigos primeiro' : 'Mais recentes primeiro';
    ordenar();
    inverterDentro();
    desenhar();
  });
  desenhar();
</script>

<style>
  .cab { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; padding: 56px 0 36px; }
  .cab h1 { font-size: clamp(64px, 11vw, 150px); line-height: .86; letter-spacing: -.0126em; color: #fbf7ff; margin: 0; }
  .lead { color: rgba(255,255,255,.76); max-width: 38ch; text-align: right; margin: 0 0 8px; }
  .linha-t { display: flex; justify-content: space-between; gap: 16px; color: rgba(255,255,255,.55); margin: 12px 0 0; padding-bottom: 56px; font-size: 12.5px; }

  .pagina { padding-bottom: 96px; }
  .barra-filtro { border-bottom: 1px solid var(--lc-dusk); padding-bottom: 28px; }
  .chip :global(.selo) { gap: 8px; }
  .chip[aria-pressed="true"] :global(.selo) { --selo-forma: #fff !important; --selo-texto: #fff !important; }
  #ordem { margin-left: 0; }

  .ano { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 40px; padding: 36px 0 44px; border-bottom: 1px solid var(--lc-hairline); }
  .ano:first-child { border-top: 0; }
  .ano h2 { font-size: clamp(56px, 6.6vw, 88px); line-height: .9; letter-spacing: -.0135em; margin: 0; }
  .ano-n { font-size: 12.5px; color: var(--fg-meta); margin: 10px 0 14px; }
  .mini-glifos { display: flex; flex-wrap: wrap; gap: 2px; max-width: 160px; }
  .mini-glifos svg { width: 24px; height: 24px; }

  .linhas { list-style: none; margin: 0; padding: 0; }
  .linhas li + li .linha { border-top: 1px solid var(--lc-hairline); }
  .linha {
    display: grid; grid-template-columns: 22px minmax(0, 1fr) 190px 96px; gap: 20px; align-items: center;
    padding: 15px 0; border-bottom: 0; color: inherit;
    transition: background 160ms var(--ease-out), padding 220ms var(--ease-out), margin 220ms var(--ease-out);
  }
  .linha:hover, .linha:focus-visible { background: #fff; padding-inline: 14px; margin-inline: -14px; }
  .linha-selo { display: flex; }
  .linha-titulo { font-family: var(--font-display); font-weight: 700; font-size: 21px; line-height: 1.16; letter-spacing: -.4px; color: var(--dvb-ink); text-wrap: balance; }
  .linha:hover .linha-titulo { color: var(--lc-ink-orange); }
  .linha-autor { font-size: 13.5px; color: var(--fg-meta); }
  .linha-mes { font-size: 12.5px; color: var(--fg-meta); text-align: right; }
  .vazio { padding: 64px 0; text-align: center; color: var(--fg-meta); }
  .mais { display: flex; flex-direction: column; align-items: center; gap: 12px; padding-top: 40px; }
  .estado { font-size: 12.5px; color: var(--fg-meta); }

  @media (max-width: 900px) {
    .cab { flex-direction: column; align-items: flex-start; }
    .lead { text-align: left; max-width: 52ch; }
    .ano { grid-template-columns: 1fr; gap: 14px; padding: 28px 0 32px; }
    .mini-glifos { display: none; }
    .ano h2 { font-size: 64px; }
    .ano-n { margin: 6px 0 0; }
  }
  @media (max-width: 760px) {
    .cab { padding: 30px 0 24px; }
    .lead { font-size: 15px; }
    .so-desktop { display: none; }
    .linha-t { padding-bottom: 32px; }
    .linha { grid-template-columns: 22px minmax(0, 1fr); gap: 4px 14px; padding: 14px 0; }
    .linha-titulo { font-size: 19px; }
    .linha-autor { grid-column: 2; font-size: 13px; }
    .linha-mes { grid-column: 2; grid-row: 3; text-align: left; font-size: 12px; }
    .linha:hover, .linha:focus-visible { padding-inline: 0; margin-inline: 0; }
  }
</style>
