---
import BaseLayout from '../layouts/BaseLayout.astro';
import AutorNome from '../components/AutorNome.astro';
import { getCollection } from 'astro:content';

const allSeries = await getCollection('series');
const series = allSeries.sort((a, b) => new Date(b.data.iniciada_em).getTime() - new Date(a.data.iniciada_em).getTime());
const allPosts = await getCollection('posts');

const formatarData = (date: Date): string => {
  return new Intl.DateTimeFormat('pt-BR', {
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
};
---

<BaseLayout title="Séries" description="Coleções temáticas de posts do datavizbr.">
  <div class="series-page">

    <div class="container">
      <header class="page-header">
        <h1>Séries</h1>
        <p class="page-subtitle">Conjunto de artigos sobre uma temática específica e aprofundada.</p>
      </header>
    </div>

    {series.map((serie) => {
      const postsDaSerie = allPosts
        .filter(p => p.data.serie?.id === serie.id && !p.data.rascunho)
        .sort((a, b) => (a.data.ordem_na_serie || 0) - (b.data.ordem_na_serie || 0));

      const statusText = serie.data.status === 'encerrada' ? 'Encerrada' : 'Em andamento';
      const corClass = `serie-capa-${serie.data.cor || 'laranja'}`;

      return (
        <section class="serie-bloco">
          <div class="container serie-container">

            <header class="serie-header">
              <a href={`/series/${serie.id}`} class="serie-capa-link">
                {serie.data.capa ? (
                  <figure class="serie-capa">
                    <img src={serie.data.capa.src} alt={serie.data.titulo} />
                  </figure>
                ) : (
                  <div class={`serie-capa-placeholder ${corClass}`} aria-hidden="true"></div>
                )}
              </a>

              <div class="serie-info">
                <p class="serie-meta">
                  <span class="badge badge-serie">Série</span>
                  <span class="serie-status">{statusText} · {postsDaSerie.length} {postsDaSerie.length === 1 ? 'parte' : 'partes'}</span>
                </p>
                <h2 class="serie-titulo">
                  <a href={`/series/${serie.id}`}>{serie.data.titulo}</a>
                </h2>
                <p class="serie-descricao">{serie.data.descricao}</p>
                <a href={`/series/${serie.id}`} class="serie-cta">Ver série completa →</a>
              </div>
            </header>

            {postsDaSerie.length > 0 && (
              <div class="posts-grid">
                {postsDaSerie.map((post, idx) => (
                  <article class="post-card">
                    <div class="post-numero">Parte {post.data.ordem_na_serie || idx + 1}</div>
                    {post.data.capa ? (
                      <img src={post.data.capa.src} alt={post.data.capa_alt || post.data.titulo} class="post-thumb" />
                    ) : (
                      <div class={`post-thumb post-thumb-placeholder ${corClass}`} aria-hidden="true"></div>
                    )}
                    <div class="post-card-body">
                      <h3 class="post-titulo">
                        <a href={`/posts/${post.id}`}>{post.data.titulo}</a>
                      </h3>
                      {post.data.descricao && (
                        <p class="post-excerpt">{post.data.descricao}</p>
                      )}
                      <div class="post-foot">
                        <span><AutorNome autorId={post.data.autores[0]?.id} /></span>
                        <span class="dot"></span>
                        <span>{formatarData(post.data.publicado_em)}</span>
                      </div>
                    </div>
                    <a href={`/posts/${post.id}`} class="post-link">Ler →</a>
                  </article>
                ))}
              </div>
            )}

          </div>
        </section>
      );
    })}

  </div>
</BaseLayout>

<style>
  .series-page {
    padding-block: var(--space-40) var(--space-48);
  }

  .page-header {
    padding-bottom: var(--space-32);
    border-bottom: 1px solid var(--border-default);
    margin-bottom: 0;
  }

  .page-header h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
    color: var(--fg-heading);
    margin-bottom: var(--space-6);
  }

  .page-subtitle {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--fg-body);
    margin: 0;
  }

  .serie-bloco {
    padding-block: var(--space-40);
    border-bottom: 1px solid var(--border-default);
  }

  .serie-bloco:last-child {
    border-bottom: none;
  }

  .serie-container {
    max-width: 960px;
  }

  /* ── HEADER ─────────────────────────────────── */
  .serie-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-20);
    align-items: center;
    margin-bottom: var(--space-24);
  }

  .serie-capa-link {
    display: block;
    border-bottom: none;
  }

  .serie-capa {
    border-radius: var(--radius-large);
    overflow: hidden;
    margin: 0;
    box-shadow: var(--elev-2);
    transition: box-shadow 160ms ease;
  }

  .serie-capa:hover {
    box-shadow: var(--elev-3);
  }

  .serie-capa img {
    width: 100%;
    height: auto;
    display: block;
  }

  .serie-capa-placeholder {
    aspect-ratio: 4/3;
    border-radius: var(--radius-large);
    box-shadow: var(--elev-2);
    transition: box-shadow 160ms ease;
  }

  .serie-capa-link:hover .serie-capa-placeholder {
    box-shadow: var(--elev-3);
  }

  .serie-capa-laranja {
    background: linear-gradient(135deg, var(--dvb-orange-100) 0%, var(--dvb-orange-50) 100%);
  }

  .serie-capa-roxa {
    background: linear-gradient(135deg, var(--dvb-purple-100) 0%, var(--dvb-purple-50) 100%);
  }

  .serie-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .serie-meta {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    margin: 0;
  }

  .serie-status {
    font-size: var(--fs-caption);
    color: var(--fg-meta);
    text-transform: uppercase;
    letter-spacing: 0.2px;
  }

  .serie-titulo {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    font-weight: 700;
    color: var(--fg-heading);
    margin: 0;
  }

  .serie-titulo a {
    color: inherit;
    border-bottom: none;
  }

  .serie-titulo a:hover {
    color: var(--color-primary);
  }

  .serie-descricao {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--fg-body);
    margin: 0;
  }

  .serie-cta {
    align-self: flex-start;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-primary);
    border-bottom: none;
  }

  .serie-cta:hover {
    color: var(--color-primary-hover);
  }

  /* ── POSTS GRID ─────────────────────────────── */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-10);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-relaxed);
    overflow: hidden;
    transition: box-shadow 160ms ease;
    position: relative;
  }

  .post-card:hover {
    box-shadow: var(--elev-2);
  }

  .post-numero {
    position: absolute;
    top: var(--space-6);
    left: var(--space-6);
    background: rgba(0,0,0,.55);
    color: #fff;
    font-size: var(--fs-caption);
    font-weight: 700;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(4px);
    z-index: 1;
  }

  .post-thumb {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
  }

  .post-thumb-placeholder {
    aspect-ratio: 16/10;
  }

  .post-card-body {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  .post-titulo {
    font-size: var(--fs-body);
    font-weight: 700;
    line-height: var(--lh-h4);
    letter-spacing: var(--ls-h4);
    color: var(--fg-heading);
    margin: 0;
  }

  .post-titulo a {
    color: inherit;
    border-bottom: none;
  }

  .post-titulo a:hover {
    color: var(--color-primary);
  }

  .post-excerpt {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--fg-body);
    margin: 0;
    flex: 1;
  }

  .post-foot {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--fg-meta);
  }

  .dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    background: var(--fg-meta);
    border-radius: 50%;
  }

  .post-link {
    align-self: flex-start;
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--color-primary);
    border-bottom: none;
    padding: var(--space-3) var(--space-8) var(--space-8);
  }

  .post-link:hover {
    color: var(--color-primary-hover);
  }

  /* ── RESPONSIVO ─────────────────────────────── */
  @media (max-width: 768px) {
    .serie-header {
      grid-template-columns: 1fr;
    }

    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
