---
// Séries: coleções de textos sobre um mesmo tema. Cada série traz a capa, o resumo e os textos.
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPostsPorSerie, getSeries } from '../lib/data';

const todas = (await getSeries()).sort(
  (a, b) => new Date(b.data.iniciada_em).getTime() - new Date(a.data.iniciada_em).getTime(),
);
const series = await Promise.all(
  todas.map(async (serie) => ({ serie, posts: await getPostsPorSerie(serie.id) })),
);
const mesAno = (d: Date) =>
  new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(d));
---

<BaseLayout title="Séries" description="Coleções temáticas de textos do datavizbr." tema="escuro">
  <header class="topo-pag grao">
    <div class="container cab">
      <h1>Séries</h1>
      <p class="apoio-mono lead">Conjuntos de textos sobre uma temática específica e aprofundada. {todas.length} séries, uma abertura de cada vez.</p>
    </div>
  </header>

  <div class="container pagina">
    {series.map(({ serie, posts }) => (
      <section class="bloco" aria-labelledby={`s-${serie.id}`}>
        <div class="bloco-topo">
          <a class="capa" href={`/series/${serie.id}`} tabindex="-1" aria-hidden="true">
            {serie.data.capa && <img src={serie.data.capa.src} alt="" loading="lazy" />}
          </a>
          <div class="info">
            <span class="eyebrow">
              {`${serie.data.status === 'encerrada' ? 'Encerrada' : 'Em andamento'} · ${posts.length} ${posts.length === 1 ? 'parte' : 'partes'} · desde ${mesAno(serie.data.iniciada_em)}`}
            </span>
            <h2 id={`s-${serie.id}`}><a href={`/series/${serie.id}`}>{serie.data.titulo}</a></h2>
            <p>{serie.data.descricao}</p>
            <a class="link-forte" href={`/series/${serie.id}`}>Ver série completa →</a>
          </div>
        </div>
        {posts.length > 0 && (
          <div class="grade">
            {posts.map((post, i) => <PostCard post={post} indice={i} />)}
          </div>
        )}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .cab { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; padding-block: 64px 64px; }
  .cab h1 { font-size: clamp(64px, 11vw, 150px); line-height: .86; letter-spacing: -.0135em; color: #fbf7ff; margin: 0; }
  .lead { color: rgba(255,255,255,.76); max-width: 38ch; text-align: right; margin: 0 0 8px; }

  .pagina { padding-block: 24px 96px; }
  .bloco { padding-block: 64px; border-bottom: 1px solid var(--lc-hairline); }
  .bloco:last-child { border-bottom: 0; }
  .bloco-topo { display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 1fr); gap: 56px; align-items: center; margin-bottom: 48px; }
  .capa { display: block; border-radius: 3px; overflow: hidden; border-bottom: 0; box-shadow: 0 0 0 1px var(--lc-hairline), 0 30px 44px -30px rgba(42,22,64,.5); }
  .capa img { display: block; width: 100%; height: auto; transition: transform 600ms var(--ease-out); }
  .capa:hover img { transform: scale(1.03); }
  .info .eyebrow { color: var(--lc-ink-orange); }
  .info h2 { font-size: clamp(36px, 4.6vw, 64px); line-height: .96; letter-spacing: -.012em; margin: 14px 0 16px; text-wrap: balance; }
  .info h2 a { color: var(--fg-heading); border-bottom: 0; }
  .info h2 a:hover { color: var(--lc-ink-orange); }
  .info p { font-size: 17px; line-height: 1.55; color: var(--dvb-ink-2); max-width: 52ch; margin: 0 0 20px; }
  .link-forte { font-weight: 600; color: var(--lc-ink-orange); border-bottom: 1px solid currentColor; }
  .grade { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 32px; }

  @media (max-width: 1000px) {
    .bloco-topo { grid-template-columns: 1fr; gap: 28px; }
    .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .cab { flex-direction: column; align-items: flex-start; padding-block: 36px; }
    .lead { text-align: left; font-size: 15px; }
    .bloco { padding-block: 44px; }
    .grade { grid-template-columns: 1fr; }
  }
</style>
