---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LivroGaleria from '../../components/LivroGaleria.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const livros = await getCollection('livros');
  return livros.map(livro => ({
    params: { slug: livro.id },
    props: { livro },
  }));
}

const { livro } = Astro.props;
const { Content } = await render(livro);

const allAutores = await getCollection('autores');
const organizadores = livro.data.organizadores
  .map(ref => allAutores.find(a => a.id === ref.id))
  .filter(Boolean);

const temGaleria = (livro.data.fotos?.length ?? 0) > 0;
const temPremios = (livro.data.premios?.length ?? 0) > 0;

const meta = [
  livro.data.ano,
  livro.data.editora,
  livro.data.paginas ? `${livro.data.paginas} páginas` : undefined,
  livro.data.tipo_acesso === 'gratuito' ? 'Acesso gratuito' : 'Pago',
].filter(Boolean).join(' · ');
const nomes = organizadores.map((o) => o!.data.nome);
const nomesOrganizadores = nomes.length > 1 ? `${nomes.slice(0, -1).join(', ')} e ${nomes.at(-1)}` : (nomes[0] ?? '');
---

<BaseLayout title={livro.data.titulo} description={livro.data.sinopse} tema="escuro">
  <header class="topo-pag grao">
    <div class="container topo">
      <div>
        <span class="eyebrow">{meta}</span>
        <h1>{livro.data.titulo}</h1>
        {livro.data.subtitulo && <p class="apoio-mono lead">{livro.data.subtitulo}</p>}
        {organizadores.length > 0 && <p class="org">Organizado por <b>{nomesOrganizadores}</b></p>}
        <p class="sinopse">{livro.data.sinopse}</p>

        {livro.data.links.length > 0 && (
          <div class="ctas">
            {livro.data.links.map((link) => (
              <a
                href={link.url}
                class:list={['btn', link.tipo === 'download_pdf' || link.tipo === 'compra' ? 'btn-sol' : 'btn-outline']}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
        <p class="formatos mono">Disponível em: {livro.data.formato.map((f) => f.toUpperCase()).join(', ')}</p>
      </div>

      <figure class="capa">
        <img src={livro.data.capa.src} alt={livro.data.capa_alt} />
      </figure>
    </div>
  </header>

  <div class="container pagina">
    {(temGaleria || temPremios) && (
      <section class="galeria" aria-label="Fotos e reconhecimentos">
        <LivroGaleria
          fotos={livro.data.fotos}
          premios={livro.data.premios}
          tituloLivro={livro.data.titulo}
          premiosTitulo="Reconhecimentos"
        />
      </section>
    )}

    {livro.data.sumario && livro.data.sumario.length > 0 && (
      <section class="sumario" aria-labelledby="sumario-titulo">
        <h2 id="sumario-titulo">Sumário</h2>
        <ol>
          {livro.data.sumario.map((cap, i) => (
            <li>
              <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="cap-titulo">{cap.titulo}</span>
              {cap.paginas && <span class="cap-paginas mono">{cap.paginas}</span>}
            </li>
          ))}
        </ol>
      </section>
    )}

    {livro.body && (
      <section class="conteudo">
        <Content />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .topo { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 72px; align-items: center; padding-block: 64px 80px; }
  .topo h1 { font-size: clamp(44px, 7vw, 100px); line-height: .92; letter-spacing: -.042em; color: #fbf7ff; margin: 20px 0 22px; text-wrap: balance; }
  .lead { color: var(--lc-peach); margin: 0 0 22px; max-width: 40ch; }
  .org { color: rgba(255,255,255,.66); font-size: 15px; margin: 0 0 22px; }
  .org b { color: #fff; font-weight: 600; }
  .sinopse { color: rgba(255,255,255,.8); font-size: 18px; line-height: 1.6; max-width: 58ch; margin: 0 0 30px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .ctas .btn-outline { color: #fbf7ff; }
  .formatos { font-size: 12.5px; color: rgba(255,255,255,.5); margin: 20px 0 0; }
  .capa { margin: 0; transform: rotate(3deg); border-radius: 3px; overflow: hidden; box-shadow: 0 50px 70px -34px rgba(0,0,0,.8); transition: transform 400ms var(--ease-spring); }
  .capa:hover { transform: rotate(1deg) translateY(-6px); }
  .capa img { display: block; width: 100%; height: auto; }

  .pagina { padding-block: 72px 104px; }
  .galeria { margin-bottom: 72px; }
  .galeria :global(.livro-galeria img) { flex: 1 0 240px; height: 360px; min-width: 0; }
  .sumario { max-width: 820px; margin-bottom: 72px; }
  .sumario h2, .conteudo :global(h2) { font-size: clamp(32px, 3.6vw, 44px); letter-spacing: -.035em; margin: 0 0 28px; }
  .sumario ol { list-style: none; margin: 0; padding: 0; }
  .sumario li { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 16px; align-items: baseline; padding: 16px 0; border-top: 1px solid var(--lc-hairline); }
  .sumario li:last-child { border-bottom: 1px solid var(--lc-hairline); }
  .num { font-size: 12.5px; color: var(--lc-ink-orange); }
  .cap-titulo { font-family: var(--font-display); font-weight: 700; font-size: 22px; line-height: 1.15; letter-spacing: -.4px; color: var(--dvb-ink); }
  .cap-paginas { font-size: 12.5px; color: var(--fg-meta); }
  .conteudo { max-width: 720px; font-size: 19px; line-height: 1.65; color: var(--dvb-ink-2); }
  .conteudo :global(p) { margin-bottom: 24px; }
  .conteudo :global(a) { color: var(--lc-ink-orange); border-bottom: 1px solid currentColor; }

  @media (max-width: 1000px) {
    .topo { grid-template-columns: 1fr; gap: 48px; padding-block: 40px 56px; }
    .capa { max-width: 280px; }
  }
  @media (max-width: 760px) {
    .sinopse { font-size: 16.5px; }
    .galeria :global(.livro-galeria img) { flex-basis: 220px; height: 260px; }
    .pagina { padding-block: 48px 72px; }
    .sumario li { grid-template-columns: 34px minmax(0, 1fr); }
    .cap-paginas { grid-column: 2; }
    .cap-titulo { font-size: 19px; }
  }
</style>
