---
// Layout padrão das séries: cabeçalho com capa e grade de cards dos posts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../PostCard.astro';
import OutrasSeries from './OutrasSeries.astro';

interface Props {
  serie: any;
  postsDaSerie: any[];
}

const { serie, postsDaSerie } = Astro.props;

const mesAno = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(serie.data.iniciada_em));
const [primeira, ...resto] = serie.data.titulo.split(' ');
---

<BaseLayout title={serie.data.titulo} description={serie.data.descricao} tema="escuro">
  <header class="topo-pag grao">
    <div class="container cab">
      <div>
        <span class="eyebrow">Série {serie.data.status === 'encerrada' ? 'encerrada' : 'em andamento'}, iniciada em {mesAno}</span>
        <h1>{primeira} {resto.length > 0 && <em>{resto.join(' ')}</em>}</h1>
        <p class="apoio-mono lead">{serie.data.descricao}</p>
        <p class="mono partes">{`${postsDaSerie.length} ${postsDaSerie.length === 1 ? 'parte' : 'partes'}`}</p>
      </div>
      {serie.data.capa && (
        <figure class="capa"><img src={serie.data.capa.src} alt={`Capa da série ${serie.data.titulo}`} /></figure>
      )}
    </div>
  </header>

  {postsDaSerie.length > 0 && (
    <section class="container posts" aria-labelledby="posts-titulo">
      <h2 id="posts-titulo">Textos desta série</h2>
      <div class="grade">
        {postsDaSerie.map((post, i) => <PostCard post={post} indice={i} />)}
      </div>
    </section>
  )}

  <OutrasSeries atual={serie.id} />
</BaseLayout>

<style>
  .cab { display: grid; grid-template-columns: minmax(0, 1fr) 440px; gap: 60px; align-items: center; padding-block: 56px 64px; }
  .cab h1 { font-size: clamp(44px, 7.4vw, 108px); line-height: .9; letter-spacing: -.0135em; color: #fbf7ff; margin: 20px 0 28px; text-wrap: balance; }
  .cab h1 em { font-style: normal; color: var(--lc-peach); }
  .lead { color: rgba(255,255,255,.76); max-width: 52ch; margin: 0; }
  .partes { font-size: 12.5px; color: rgba(255,255,255,.5); margin: 22px 0 0; }
  .capa { margin: 0; border-radius: 3px; overflow: hidden; box-shadow: 0 40px 60px -30px rgba(0,0,0,.7); }
  .capa img { display: block; width: 100%; height: auto; }
  .posts { padding-block: 80px 8px; }
  .posts h2 { font-size: clamp(32px, 3.6vw, 44px); letter-spacing: -.0105em; margin: 0 0 32px; }
  .grade { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 32px; }
  @media (max-width: 1000px) {
    .cab { grid-template-columns: 1fr; gap: 36px; padding-block: 40px; }
    .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) { .grade { grid-template-columns: 1fr; } .posts { padding-top: 52px; } }
</style>
