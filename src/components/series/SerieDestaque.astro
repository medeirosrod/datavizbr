---
// Layout de destaque: mapa em largura total, regra da série, linha do tempo e sugestão de dados.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AutorNome from '../AutorNome.astro';
import { SITE } from '../../consts';

interface Props {
  serie: any;
  postsDaSerie: any[];
}

const { serie, postsDaSerie } = Astro.props;
const proximos: string[] = serie.data.proximos;

const formatarData = (date: Date): string =>
  new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(date));

// linha do tempo: capítulos publicados (com link) seguidos dos que ainda vêm
const capitulos = [
  ...postsDaSerie.map((post, i) => ({
    numero: post.data.ordem_na_serie ?? i + 1,
    titulo: post.data.titulo,
    descricao: post.data.descricao,
    href: `/posts/${post.id}`,
    data: formatarData(post.data.publicado_em),
    autor: post.data.autores[0]?.id,
  })),
  ...proximos.map((titulo, i) => ({
    numero: postsDaSerie.length + i + 1,
    titulo,
    descricao: undefined,
    href: undefined,
    data: undefined,
    autor: undefined,
  })),
];

const assunto = encodeURIComponent(`Dado para a série ${serie.data.titulo}`);
---

<BaseLayout title={serie.data.titulo} description={serie.data.descricao}>
  <article class="serie">
    <header class="serie-topo">
      {serie.data.capa && (
        <figure class="serie-capa">
          <img src={serie.data.capa.src} alt={`Mapa do Brasil com os nove estados do Nordeste se acendendo, capa da série ${serie.data.titulo}`} />
        </figure>
      )}
      <div class="serie-intro">
        <p class="serie-status">
          Série · {serie.data.status === 'encerrada' ? 'Encerrada' : 'Em andamento'}
        </p>
        <h1 class="serie-titulo">{serie.data.titulo}</h1>
        <p class="serie-descricao">{serie.data.descricao}</p>
      </div>
    </header>

    <div class="serie-corpo">
      <section class="serie-sobre">
        <slot />
      </section>

      <ul class="serie-regra" aria-label="Regra da série">
        <li><strong>Dado público</strong><span>só entram bases abertas, que qualquer pessoa pode baixar.</span></li>
        <li><strong>Fonte citada</strong><span>cada gráfico diz de onde vêm os números.</span></li>
        <li><strong>Método aberto</strong><span>cada capítulo explica como a conta foi feita.</span></li>
      </ul>

      <section class="serie-capitulos" aria-labelledby="capitulos">
        <h2 id="capitulos">Capítulos</h2>
        <ol class="linha-do-tempo">
          {capitulos.map((c) => (
            <li class:list={['capitulo', { 'em-breve': !c.href }]}>
              <span class="capitulo-numero" aria-hidden="true">{c.numero}</span>
              <div class="capitulo-corpo">
                {c.href ? (
                  <h3 class="capitulo-titulo"><a href={c.href}>{c.titulo}</a></h3>
                ) : (
                  <h3 class="capitulo-titulo">{c.titulo}</h3>
                )}
                {c.descricao && <p class="capitulo-descricao">{c.descricao}</p>}
                <p class="capitulo-meta">
                  {c.href ? (
                    <>
                      <AutorNome autorId={c.autor} /> · {c.data}
                    </>
                  ) : (
                    <span class="selo">Em breve</span>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <aside class="serie-sugestao">
        <h2>Tem um dado sobre o Nordeste?</h2>
        <p>Se você conhece uma base pública que merece um gráfico, conte para a gente. Os próximos capítulos nascem dessas sugestões.</p>
        <a class="btn btn-primary" href={`mailto:${SITE.email_contato}?subject=${assunto}`}>Sugerir um dado</a>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .serie {
    padding-bottom: var(--space-32);
  }

  /* ---- topo: mapa animado ocupa a largura toda ---- */
  .serie-topo {
    background: var(--dvb-purple-deep, #2a1640);
    color: #fff;
  }
  .serie-capa {
    margin: 0;
    background: var(--dvb-purple-deep, #2a1640);
  }
  .serie-capa img {
    display: block;
    width: 100%;
    max-height: 60svh;
    object-fit: contain;
  }
  .serie-intro {
    max-width: 720px;
    margin-inline: auto;
    padding: var(--space-12) var(--space-8) var(--space-20);
  }
  .serie-status {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-caption);
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--dvb-orange-300, #f4b07a);
  }
  .serie-titulo {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 8vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -1px;
    color: #fff;
  }
  .serie-descricao {
    margin: 0;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: rgba(255, 255, 255, 0.86);
  }

  /* ---- corpo ---- */
  .serie-corpo {
    max-width: 720px;
    margin-inline: auto;
    padding: var(--space-16) var(--space-8) 0;
  }
  .serie-sobre :global(p) {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--fg-body);
  }

  .serie-regra {
    list-style: none;
    margin: var(--space-16) 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .serie-regra li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-8) var(--space-8);
    background: var(--dvb-orange-50, #fef5ec);
    border-left: 4px solid var(--dvb-orange, #e67e2c);
    border-radius: var(--radius-relaxed);
  }
  .serie-regra strong {
    color: var(--fg-heading);
  }
  .serie-regra span {
    font-size: var(--fs-body-sm);
    color: var(--fg-body);
  }

  /* ---- linha do tempo ---- */
  .serie-capitulos h2,
  .serie-sugestao h2 {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    color: var(--fg-heading);
    margin: 0 0 var(--space-8);
  }
  .linha-do-tempo {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .linha-do-tempo::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border-default);
  }
  .capitulo {
    position: relative;
    display: flex;
    gap: var(--space-8);
    padding-bottom: var(--space-12);
  }
  .capitulo-numero {
    flex: none;
    z-index: 1;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--dvb-orange, #e67e2c);
    color: #fff;
    font-weight: 700;
  }
  .em-breve .capitulo-numero {
    background: var(--bg-page, #fff);
    border: 2px solid var(--border-default);
    color: var(--fg-meta);
  }
  .capitulo-corpo {
    padding-top: 4px;
  }
  .capitulo-titulo {
    margin: 0;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-h4);
    color: var(--fg-heading);
  }
  .em-breve .capitulo-titulo {
    color: var(--fg-meta);
  }
  .capitulo-titulo a {
    color: inherit;
    border-bottom: none;
  }
  .capitulo-titulo a:hover {
    color: var(--fg-accent);
  }
  .capitulo-descricao {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-body-sm);
    color: var(--fg-body);
  }
  .capitulo-meta {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-caption);
    color: var(--fg-meta);
  }
  .selo {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  /* ---- sugestão ---- */
  .serie-sugestao {
    margin-top: var(--space-16);
    padding: var(--space-12);
    background: var(--dvb-purple-50, #f6eefb);
    border-radius: var(--radius-large);
  }
  .serie-sugestao p {
    margin: 0 0 var(--space-8);
    color: var(--fg-body);
  }

  @media (min-width: 768px) {
    .serie-regra {
      grid-template-columns: repeat(3, 1fr);
    }
    .serie-intro {
      padding-inline: 0;
    }
    .serie-corpo {
      padding-inline: 0;
    }
  }
</style>
