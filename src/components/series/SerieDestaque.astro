---
// Layout de destaque: mapa em largura total, regra da série, linha do tempo e sugestão de dados.
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutrasSeries from './OutrasSeries.astro';
import { SITE } from '../../consts';

interface Props {
  serie: any;
  postsDaSerie: any[];
}

const { serie, postsDaSerie } = Astro.props;
const proximos: string[] = serie.data.proximos;

const mesAno = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(serie.data.iniciada_em));
const [primeira, ...resto] = serie.data.titulo.split(' ');

const assunto = encodeURIComponent(`Dado para a série ${serie.data.titulo}`);
---

<BaseLayout title={serie.data.titulo} description={serie.data.descricao} tema="escuro">
  <header class="topo-pag grao">
    <div class="container">
      <div class="cab">
        <div>
          <span class="eyebrow">Série {serie.data.status === 'encerrada' ? 'encerrada' : 'em andamento'}, iniciada em {mesAno}</span>
          <h1>{primeira} {resto.length > 0 && <em>{resto.join(' ')}</em>}</h1>
          <p class="apoio-mono lead">{serie.data.descricao}</p>
        </div>
        {serie.data.capa && (
          <figure class="capa">
            <img src={serie.data.capa.src} alt={`Capa da série ${serie.data.titulo}`} />
          </figure>
        )}
      </div>

      <ol class="caps" aria-label="Capítulos">
        {postsDaSerie.map((post, i) => (
          <li class="cap cap-aberto">
            <span class="n">{post.data.ordem_na_serie ?? i + 1}</span>
            <h2><a href={`/posts/${post.id}`}>{post.data.titulo}</a></h2>
            {post.data.descricao && <p>{post.data.descricao}</p>}
            <a class="btn btn-sol" href={`/posts/${post.id}`}>Ler o capítulo</a>
          </li>
        ))}
        {proximos.map((titulo, i) => (
          <li class="cap cap-fechado">
            <span class="n">{postsDaSerie.length + i + 1}</span>
            <h2>{titulo}</h2>
            <small>em breve</small>
          </li>
        ))}
      </ol>
      <p class="mono legenda">{`${postsDaSerie.length} ${postsDaSerie.length === 1 ? 'capítulo aberto' : 'capítulos abertos'}, ${proximos.length} por abrir`}</p>
    </div>
  </header>

  <div class="container corpo">
    <section class="sobre">
      <slot />
    </section>

    <ul class="regra" aria-label="Regra da série">
      <li><strong>Dado público</strong><span>só entram bases abertas, que qualquer pessoa pode baixar.</span></li>
      <li><strong>Fonte citada</strong><span>cada gráfico diz de onde vêm os números.</span></li>
      <li><strong>Método aberto</strong><span>cada capítulo explica como a conta foi feita.</span></li>
    </ul>

    <aside class="sugestao">
      <div>
        <h2>Tem um dado sobre o Nordeste?</h2>
        <p>Se você conhece uma base pública que merece um gráfico, conte para a gente. Os próximos capítulos nascem dessas sugestões.</p>
      </div>
      <a class="btn btn-primary" href={`mailto:${SITE.email_contato}?subject=${assunto}`}>Sugerir um dado</a>
    </aside>
  </div>

  <OutrasSeries atual={serie.id} />
</BaseLayout>

<style>
  .cab { display: grid; grid-template-columns: minmax(0, 1fr) 520px; gap: 60px; align-items: center; padding: 56px 0 56px; }
  .cab h1 { font-size: clamp(48px, 8.4vw, 124px); line-height: .88; letter-spacing: -.0135em; color: #fbf7ff; margin: 20px 0 28px; text-wrap: balance; }
  .cab h1 em { font-style: normal; color: var(--lc-peach); display: block; }
  .lead { color: rgba(255,255,255,.76); max-width: 52ch; margin: 0; }
  .capa { margin: 0; border-radius: 3px; overflow: hidden; box-shadow: 0 40px 60px -30px rgba(0,0,0,.7); }
  .capa img { display: block; width: 100%; height: auto; }

  .caps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .cap { position: relative; min-height: 330px; padding: 22px 24px 24px; border-radius: 3px; display: flex; flex-direction: column; align-items: flex-start; }
  .cap .n { font-family: var(--font-display); font-weight: 700; font-size: 64px; line-height: .9; letter-spacing: -.72px; margin-bottom: 18px; }
  .cap h2 { font-size: 25px; line-height: 1.08; letter-spacing: -.6px; margin: auto 0 0; text-wrap: balance; }
  .cap-aberto { background: linear-gradient(to bottom, #2a1837, #1d1028); border: 1px solid rgba(255,255,255,.14); color: #fbf7ff; }
  /* A luz do pôr do sol aparece só na borda, ao passar o mouse ou focar: o cartão em si não leva degradê. */
  .cap-aberto { transition: transform 240ms var(--ease-out); }
  .cap-aberto::before { content: ""; position: absolute; inset: -1px; padding: 1px; border-radius: 3px; pointer-events: none;
    background: linear-gradient(135deg, #4b2c80, #8a58ad 30%, #d98aa6 55%, #f6ab72 78%, #e9772a);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask-composite: exclude;
    opacity: 0; transition: opacity 240ms var(--ease-out); }
  .cap-aberto:hover { transform: translateY(-4px); }
  .cap-aberto:hover::before, .cap-aberto:focus-within::before { opacity: 1; }
  .cap-aberto h2, .cap-aberto h2 a { color: #fbf7ff; border-bottom: 0; }
  .cap-fechado h2 { color: rgba(255,255,255,.82); }
  .cap-aberto p { font-size: 14.5px; line-height: 1.5; color: rgba(255,255,255,.74); margin: 12px 0 18px; }
  .cap-fechado { border: 1px dashed rgba(255,255,255,.34); color: rgba(255,255,255,.74); }
  .cap-fechado small { font-size: 13px; font-weight: 500; margin-top: 8px; }
  .legenda { font-size: 12.5px; color: rgba(255,255,255,.5); margin: 18px 0 0; padding-bottom: 72px; }

  .corpo { padding-block: 88px 24px; }
  .sobre { max-width: 720px; font-size: 19px; line-height: 1.65; color: var(--dvb-ink-2); }
  .sobre :global(p) { margin-bottom: 24px; }
  .sobre :global(a) { color: var(--lc-ink-orange); border-bottom: 1px solid currentColor; }
  .regra { list-style: none; margin: 56px 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .regra li { display: flex; flex-direction: column; gap: 8px; padding-top: 20px; border-top: 2px solid var(--dvb-ink); font-size: 16px; line-height: 1.5; color: var(--dvb-ink-2); }
  .regra strong { font-family: var(--font-display); font-size: 26px; letter-spacing: -.6px; color: var(--dvb-ink); }
  .sugestao { display: flex; justify-content: space-between; align-items: center; gap: 32px; padding: 32px; background: #fff; border-radius: 3px; box-shadow: 0 0 0 1px var(--lc-hairline); }
  .sugestao h2 { font-size: 32px; letter-spacing: -.24px; margin: 0 0 10px; }
  .sugestao p { margin: 0; color: var(--dvb-ink-2); max-width: 56ch; }
  .sugestao .btn { flex: none; }

  @media (max-width: 1100px) {
    .cab { grid-template-columns: 1fr; gap: 36px; }
    .caps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .cab { padding-block: 32px; }
    .caps { grid-template-columns: 1fr; }
    .cap { min-height: 260px; }
    .legenda { padding-bottom: 48px; }
    .corpo { padding-top: 56px; }
    .regra { grid-template-columns: 1fr; gap: 24px; }
    .sugestao { flex-direction: column; align-items: flex-start; padding: 24px; }
  }
</style>
