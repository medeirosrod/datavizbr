---
// Capa padrão para posts sem imagem em `capa`: azulejo da seção (DESIGN.md, "Painel de azulejo").
import Azulejo from './Azulejo.astro';
import type { Secao } from '../lib/formas';

interface Props {
  secao?: Secao;
  /** Proporção do quadro. Padrão casa com os thumbs dos cards. */
  proporcao?: string;
  class?: string;
}

const { secao = 'panorama', proporcao = '16 / 10', class: className = '' } = Astro.props;
---

<div class={`capa-padrao ${className}`} style={`aspect-ratio: ${proporcao}`}>
  <Azulejo secao={secao} colunas={5} linhas={3} />
</div>

<style>
  .capa-padrao { display: block; width: 100%; overflow: hidden; }
</style>
