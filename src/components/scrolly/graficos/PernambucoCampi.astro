---
// Passo 4: Pernambuco, cidades com câmpus de universidade federal e o ano de chegada.
import Moldura from '../Moldura.astro';
import geo from '../../../data/universidades/geo.json';

const OX = 6;
const OY = 150;
// rótulo: [dx, dy, âncora]
const pos: Record<string, [number, number, string]> = {
  Recife: [-2, -12, 'end'], Petrolina: [10, 4, 'start'], Garanhuns: [0, 20, 'middle'], 'Serra Talhada': [0, -12, 'middle'],
  Caruaru: [0, 34, 'middle'], 'Vitória de Santo Antão': [0, 0, 'end'], 'Cabo de Santo Agostinho': [0, 0, 'end'],
  'Belo Jardim': [0, -12, 'middle'], Salgueiro: [0, -12, 'middle'],
};
const cidades = geo.pe.cidades.map((c, i) => ({ ...c, antiga: c.ano === null, d: 0.1 + i * 0.09 }));
const lista = cidades.filter((c) => !c.antiga);
---

<Moldura
  titulo="Pernambuco: cidades com câmpus de universidade federal"
  rotulo="Mapa de Pernambuco com as cidades que têm câmpus de universidade federal. Recife já tinha a UFPE e a UFRPE. Depois de 2002 chegaram Petrolina (Univasf, aulas desde 2004), Garanhuns (2005), Serra Talhada (2006), Cabo de Santo Agostinho (2014), Belo Jardim (2017), Caruaru, Vitória de Santo Antão e Salgueiro."
  fonte="Fonte: UFRPE (Relato Institucional, 2019), UFPE e Univasf. Elaboração: datavizbr. Só universidades federais; institutos federais e a rede estadual (UPE) ficam de fora."
>
  <g class="lista">
    {lista.map((c, i) => (
      <g class="rv rv-fade" style={`--d:${c.d};--s:0.08`}>
        <circle class="num" cx={i < 4 ? 9 : 253} cy={11 + (i % 4) * 30} r="9" />
        <text class="n" x={i < 4 ? 9 : 253} y={15 + (i % 4) * 30} font-size="11">{i + 1}</text>
        <text class="t-laranja" x={i < 4 ? 26 : 270} y={16 + (i % 4) * 30} font-size="14">{c.ano || 'depois'}</text>
        <text class="t-forte" x={i < 4 ? 80 : 324} y={16 + (i % 4) * 30} font-size="13">{c.nome}</text>
        <text x={i < 4 ? 80 : 324} y={30 + (i % 4) * 30} font-size="11.5">{c.ies}</text>
      </g>
    ))}
  </g>
  <g transform={`translate(${OX} ${OY})`}>
    <path d={geo.pe.d} class="pe" />
    {cidades.map((c) =>
      c.antiga ? (
        <g class="antiga">
          <circle cx={c.x} cy={c.y} r="7" />
          <text x={c.x - 2} y={c.y - 13} text-anchor="end" font-size="12">Recife, antes de 2002</text>
        </g>
      ) : (
        <g class="rv rv-fade nova" style={`--d:${c.d};--s:0.08`}>
          <circle cx={c.x} cy={c.y} r="9" />
          <text class="n" x={c.x} y={c.y + 4} font-size="11">{lista.indexOf(c) + 1}</text>
        </g>
      )
    )}
  </g>
  <text x="6" y="350" font-size="12">Em 2001, universidade federal em Pernambuco era só no Recife.</text>
</Moldura>

<style>
  .pe { fill: #ebe4f0; stroke: #fff; stroke-width: 1.2; }
  .antiga circle { fill: var(--g-tinta); stroke: #fff; stroke-width: 1.5; }
  .antiga text { fill: var(--g-tinta); font-weight: 700; }
  .nova circle, .num { fill: var(--g-laranja); stroke: #fff; stroke-width: 1.5; }
  .n { fill: #fff; font-weight: 700; text-anchor: middle; }
</style>
