---
// Moldura comum dos gráficos do scrollytelling: título e fonte em HTML (legíveis
// no celular), SVG em viewBox fixo no meio. Os filhos são o conteúdo do <svg>.
import './scrolly.css';

interface Props {
  titulo: string;
  /** Descrição completa para leitores de tela (equivale ao alt de uma imagem). */
  rotulo: string;
  fonte: string;
}
const { titulo, rotulo, fonte } = Astro.props;
---

<figure class="grafico" role="img" aria-label={rotulo}>
  <p class="g-titulo">{titulo}</p>
  <svg viewBox="0 0 480 380" aria-hidden="true" focusable="false">
    <slot />
  </svg>
  <figcaption class="g-fonte">{fonte}</figcaption>
</figure>

<style is:global>
  /* Luz Coada: cartão Paper sobre a cal, base em Lilac Tint, um destaque em Clay,
     valor do destaque em Deep, título em Bricolage, dado e fonte em IBM Plex Mono.
     Signal (#e67e2c) não é cor de texto sobre claro. Sem degradê em marca de dado. */
  .grafico {
    --g-laranja: var(--lc-clay, #c8651a);
    --g-deep: var(--dvb-orange-deep, #9a4a0d);
    --g-cinza: var(--lc-lilac-tint, #e2d2f3);
    --g-claro: var(--lc-cal-shade, #ebe4f0);
    --g-roxo: var(--dvb-purple, #552b7b);
    --g-lilas: var(--lc-lilac, #b9a3d6);
    --g-tinta: var(--dvb-ink, #1a0f24);
    --g-mudo: var(--dvb-ink-3, #6b5d76);
    margin: 0;
    width: 100%;
    box-sizing: border-box;
    padding: 14px 14px 10px;
    background: #fff;
    border: 1px solid var(--lc-hairline, #ddd3e5);
    border-radius: 3px;
  }
  /* no palco fixo o contêiner já é o cartão */
  .scrolly-palco .grafico {
    padding: 0;
    border: 0;
    background: transparent;
  }
  .grafico svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .g-titulo {
    margin: 0 0 8px;
    font-family: var(--font-display, 'Bricolage Grotesque', sans-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--g-tinta);
  }
  .g-fonte {
    margin-top: 6px;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--g-mudo);
  }
  /* o tamanho padrão fica no <svg>, para o atributo font-size dos <text> poder sobrescrevê-lo */
  .grafico svg {
    font-size: 13px;
  }
  .grafico text {
    font-family: var(--font-sans, 'IBM Plex Sans', sans-serif);
    fill: var(--g-mudo);
  }
  .grafico .t-forte {
    font-weight: 700;
    fill: var(--g-tinta);
  }
  .grafico .t-laranja {
    font-weight: 700;
    fill: var(--g-deep);
  }
  .grafico .t-num {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    letter-spacing: -0.02em;
  }
  .grafico .t-fim {
    text-anchor: end;
  }
  .grafico .t-meio {
    text-anchor: middle;
  }
</style>
