---
// Contêiner do scrollytelling. Uso em MDX:
//   <Scrolly>
//     <Passo grafico="vento-por-mes" etapa={1}>texto…</Passo>
//     …
//   </Scrolly>
// Padrão (sem JS, movimento reduzido ou conexão lenta): texto corrido com cada
// gráfico estático logo abaixo. Com JS: gráfico fixo no topo (celular) ou ao lado
// (tela larga) e textos rolando; a rolagem escreve --p (0 a 1) no gráfico.
import './scrolly.css';
---

<div class="scrolly" data-scrolly>
  <div class="scrolly-palco" aria-live="polite"></div>
  <div class="scrolly-passos"><slot /></div>
</div>

<style is:global>
  .scrolly {
    --scrolly-w: min(100vw, 1120px);
    width: var(--scrolly-w);
    margin-block: var(--space-16, 32px);
    margin-left: calc(50% - var(--scrolly-w) / 2);
    padding-inline: 16px;
    box-sizing: border-box;
  }

  /* ---- versão estática (padrão) ---- */
  .scrolly-palco { display: none; }
  .scrolly-passos { max-width: 720px; margin-inline: auto; }
  .passo-fig { margin-block: 20px 40px; }
  .passo-fig[data-so-palco] { display: none; }

  /* ---- versão com rolagem ---- */
  .scrolly--ativo .passo-fig { display: none; }
  .scrolly--ativo .scrolly-palco {
    display: block;
    position: sticky;
    top: var(--nav-h, 56px);
    z-index: 5;
    margin-inline: -16px;
    padding: 10px 16px 8px;
    background: var(--bg-page, #fff);
    border-bottom: 1px solid var(--border-default, #e8e3ee);
  }
  .scrolly-palco .grafico[hidden] { display: none; }
  .scrolly--ativo .scrolly-passos { max-width: none; }
  .scrolly--ativo .passo {
    min-height: 75svh;
    display: flex;
    align-items: flex-start;
    padding-block: 24px 12vh;
  }
  .scrolly--ativo .passo-texto {
    max-width: 560px;
    margin-inline: auto;
  }

  @media (min-width: 960px) {
    .scrolly--ativo {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 48px;
    }
    .scrolly--ativo .scrolly-palco {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      top: calc(var(--nav-h, 56px) + 24px);
      margin: 0;
      padding: 20px;
      border: 1px solid var(--border-default, #e8e3ee);
      border-radius: var(--radius-large, 12px);
    }
    .scrolly--ativo .scrolly-passos {
      grid-column: 1;
      grid-row: 1;
    }
    .scrolly--ativo .passo { min-height: 90svh; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduzMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conexao = (navigator as any).connection;
  const conexaoLenta = Boolean(conexao?.saveData) || /(^|-)2g$/.test(conexao?.effectiveType ?? '');

  if (!reduzMovimento && !conexaoLenta) {
    gsap.registerPlugin(ScrollTrigger);
    document.querySelectorAll<HTMLElement>('[data-scrolly]').forEach(iniciar);
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }

  function iniciar(raiz: HTMLElement) {
    const palco = raiz.querySelector<HTMLElement>('.scrolly-palco')!;
    const passos = [...raiz.querySelectorAll<HTMLElement>('.passo')];
    if (!passos.length) return;

    // um gráfico por id, clonado do primeiro passo que o usa
    const figuras = new Map<string, HTMLElement>();
    passos.forEach((p) => {
      const id = p.dataset.grafico!;
      if (figuras.has(id)) return;
      const clone = p.querySelector<HTMLElement>('.passo-fig > .grafico')!.cloneNode(true) as HTMLElement;
      clone.hidden = true;
      clone.style.setProperty('--p', '0');
      palco.append(clone);
      figuras.set(id, clone);
    });

    const nav = document.querySelector<HTMLElement>('.nav');
    raiz.style.setProperty('--nav-h', `${nav?.offsetHeight ?? 56}px`);
    raiz.classList.add('scrolly--ativo');

    // índice do primeiro passo de cada gráfico: é nele que a rolagem desenha o gráfico
    const primeiro = new Map<string, number>();
    passos.forEach((p, i) => primeiro.has(p.dataset.grafico!) || primeiro.set(p.dataset.grafico!, i));

    // linha de ativação: logo abaixo do palco no celular, meio da tela no desktop
    const linha = () =>
      matchMedia('(min-width: 960px)').matches
        ? innerHeight * 0.5
        : (nav?.offsetHeight ?? 56) + palco.offsetHeight + 90;

    // Estado calculado a cada rolagem a partir das posições reais (sem medidas em cache,
    // que ficariam velhas quando fontes carregam ou o palco muda de altura).
    const atualizar = () => {
      const l = linha();
      let i = 0;
      passos.forEach((p, k) => {
        if (p.getBoundingClientRect().top <= l) i = k;
      });
      const r = passos[i].getBoundingClientRect();
      const andamento = Math.min(1, Math.max(0, (l - r.top) / (r.height || 1)));
      const atual = passos[i].dataset.grafico!;

      figuras.forEach((fig, id) => {
        fig.hidden = id !== atual;
        const p = id === atual ? (primeiro.get(id) === i ? Math.min(1, andamento * 1.5) : 1) : primeiro.get(id)! < i ? 1 : 0;
        fig.style.setProperty('--p', String(p));
      });
      figuras.get(atual)!.dataset.etapa = passos[i].dataset.etapa;
    };

    ScrollTrigger.create({
      trigger: raiz,
      start: 'top bottom',
      end: 'bottom top',
      onUpdate: atualizar,
      onLeave: atualizar,
      onLeaveBack: atualizar,
      onRefresh: atualizar,
    });
    // o palco muda de altura quando fontes carregam ou a tela gira
    new ResizeObserver(() => ScrollTrigger.refresh()).observe(palco);
    atualizar();
  }
</script>
