---
// "Em destaque": um palco grande e uma linha de abas com progresso.
// Troca sozinho a cada 7 s, pausa com mouse, foco ou botão, e não troca
// sozinho para quem pede menos movimento (DESIGN.md, "Motion").
import type { CollectionEntry } from 'astro:content';
import Selo from './Selo.astro';
import AutorNome from './AutorNome.astro';
import { formatarMesAno } from '../lib/data';
import type { Secao } from '../lib/formas';

interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
---

<section class="destaque" data-destaque aria-roledescription="carrossel" aria-label="Em destaque">
  <div class="palco">
    {posts.map((p, i) => (
      <article
        class:list={['slide', i === 0 && 'on']}
        id={`slide-${i}`}
        role="tabpanel"
        aria-labelledby={`aba-${i}`}
        inert={i !== 0}
        data-slide
      >
        <div class="capa">
          {(p.data.capa_destaque ?? p.data.capa) ? <img src={(p.data.capa_destaque ?? p.data.capa)!.src} alt={p.data.capa_alt || p.data.titulo} /> : <div class="capa-vazia"></div>}
          <div class="veu" aria-hidden="true"></div>
        </div>
        <div class="texto">
          <Selo secao={p.data.secao as Secao} />
          <h2><a href={`/posts/${p.id}`}>{p.data.titulo}</a></h2>
          <p class="lead">{p.data.descricao || p.data.subtitulo}</p>
          <div class="autor">
            <span class="autor-nome"><AutorNome autorId={p.data.autores[0]?.id} /></span>
            <span class="autor-data">{formatarMesAno(p.data.publicado_em)}</span>
          </div>
          <a class="btn btn-primary btn-cantos" href={`/posts/${p.id}`}>
            Ler o texto<i></i><i></i><i></i><i></i>
          </a>
        </div>
      </article>
    ))}
  </div>

  <div class="abas" role="tablist" aria-label="Escolher destaque">
    {posts.map((p, i) => (
      <button
        type="button"
        role="tab"
        id={`aba-${i}`}
        class:list={['aba', i === 0 && 'on']}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`slide-${i}`}
        tabindex={i === 0 ? 0 : -1}
        data-aba
      >
        <span class="prog" aria-hidden="true"><i></i></span>
        {p.data.capa ? <img src={p.data.capa.src} alt="" /> : <span class="miniatura-vazia"></span>}
        <span class="aba-texto">
          <Selo secao={p.data.secao as Secao} />
          <strong>{p.data.titulo}</strong>
        </span>
      </button>
    ))}
  </div>

  {posts.length > 1 && (
    <div class="ctrl">
      <button type="button" class="pausa" data-pausa aria-pressed="false" aria-label="Pausar a troca automática">
        <svg class="i-pausa" width="10" height="12" viewBox="0 0 10 12" aria-hidden="true"><rect width="3.2" height="12" fill="currentColor"/><rect x="6.8" width="3.2" height="12" fill="currentColor"/></svg>
        <svg class="i-toca" width="10" height="12" viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0l10 6-10 6z" fill="currentColor"/></svg>
      </button>
      <span class="mono" data-status aria-live="polite">1 de {posts.length}. Troca sozinho e pausa quando você passa o mouse.</span>
    </div>
  )}
</section>

<style>
  .destaque { --u: 78px; }
  .palco { display: grid; }
  .slide {
    grid-area: 1 / 1;
    display: grid; grid-template-columns: minmax(0, 700px) minmax(0, 1fr); gap: 64px; align-items: center;
    align-self: start; opacity: 0; visibility: hidden;
    transition: opacity 420ms var(--ease-out), visibility 0s linear 420ms;
  }
  .slide.on { opacity: 1; visibility: visible; transition-delay: 0s; }

  .capa { position: relative; height: calc(var(--u) * 6); overflow: hidden; border-radius: 3px; background: var(--lc-dusk); }
  .capa img { max-width: none; position: absolute; left: -60px; top: -40px; width: calc(100% + 110px); height: calc(100% + 80px); object-fit: cover; }
  .capa-vazia { position: absolute; inset: 0; background: var(--lc-wall); }
  /* Véu: faixa de argila com aberturas circulares; a capa aparece por elas */
  .veu {
    position: absolute; right: 0; top: 0; bottom: 0; width: calc(var(--u) * 2);
    background:
      linear-gradient(to right, transparent calc(50% - 1px), #a9520f calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)),
      repeating-linear-gradient(to bottom, transparent 0 calc(var(--u) - 1px), #a9520f calc(var(--u) - 1px) var(--u)),
      var(--lc-clay);
    -webkit-mask: radial-gradient(circle at 50% 50%, transparent 0 calc(var(--u) * .35), #000 calc(var(--u) * .353)) 0 0 / var(--u) var(--u);
            mask: radial-gradient(circle at 50% 50%, transparent 0 calc(var(--u) * .35), #000 calc(var(--u) * .353)) 0 0 / var(--u) var(--u);
    filter: drop-shadow(-8px 0 14px rgba(42, 22, 64, .35));
  }

  .texto { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .texto h2 { font-size: 52px; line-height: 1; letter-spacing: -1.8px; text-wrap: balance; }
  .texto h2 a { color: var(--dvb-ink); border-bottom: 0; }
  .texto h2 a:hover { color: var(--lc-ink-orange); }
  .lead { font-family: var(--font-mono); font-size: 17px; line-height: 1.55; letter-spacing: -.2px; color: var(--dvb-ink-2); max-width: 62ch; }
  .autor { display: flex; flex-direction: column; font-size: 14px; color: var(--dvb-ink-3); }
  .autor-nome { color: var(--dvb-ink); font-weight: 600; }

  .btn-cantos { position: relative; height: 46px; padding: 0 24px; margin-top: 6px; }
  .btn-cantos i { position: absolute; width: 10px; height: 10px; border: 2px solid var(--dvb-orange-deep); opacity: 0; transition: opacity 160ms var(--ease-out), transform 220ms var(--ease-spring); }
  .btn-cantos i:nth-of-type(1) { left: -8px; top: -8px; border-right: 0; border-bottom: 0; }
  .btn-cantos i:nth-of-type(2) { right: -8px; top: -8px; border-left: 0; border-bottom: 0; }
  .btn-cantos i:nth-of-type(3) { left: -8px; bottom: -8px; border-right: 0; border-top: 0; }
  .btn-cantos i:nth-of-type(4) { right: -8px; bottom: -8px; border-left: 0; border-top: 0; }
  .btn-cantos:hover i, .btn-cantos:focus-visible i { opacity: 1; }
  .btn-cantos:hover i:nth-of-type(1), .btn-cantos:focus-visible i:nth-of-type(1) { transform: translate(-2px, -2px); }
  .btn-cantos:hover i:nth-of-type(2), .btn-cantos:focus-visible i:nth-of-type(2) { transform: translate(2px, -2px); }
  .btn-cantos:hover i:nth-of-type(3), .btn-cantos:focus-visible i:nth-of-type(3) { transform: translate(-2px, 2px); }
  .btn-cantos:hover i:nth-of-type(4), .btn-cantos:focus-visible i:nth-of-type(4) { transform: translate(2px, 2px); }
  .btn-cantos:focus-visible { outline: none; }

  /* Abas com progresso */
  .abas { display: grid; grid-template-columns: repeat(var(--n, 3), 1fr); gap: 28px; margin-top: 68px; }
  .aba {
    position: relative; display: grid; grid-template-columns: 104px 1fr; gap: 18px; align-items: center;
    padding: 22px 0 0; text-align: left; background: none; border: 0; cursor: pointer; font: inherit; color: inherit;
  }
  .aba .prog { position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--lc-hairline); }
  .aba .prog i { display: block; height: 100%; width: 0; background: var(--lc-clay); }
  .aba.on .prog i { animation: prog var(--dur, 7s) linear forwards; }
  [data-pausado] .aba.on .prog i { animation-play-state: paused; }
  .aba img, .miniatura-vazia { width: 104px; height: 70px; object-fit: cover; border-radius: 3px; border: 1px solid var(--lc-hairline); background: var(--lc-cal-shade); }
  .aba-texto { display: flex; flex-direction: column; gap: 7px; }
  .aba strong { font-family: var(--font-display); font-size: 20px; line-height: 1.12; letter-spacing: -.4px; color: var(--dvb-ink-2); transition: color 160ms; }
  .aba.on strong, .aba:hover strong { color: var(--dvb-ink); }
  .aba:focus-visible { outline: 2px solid var(--dvb-orange); outline-offset: 4px; }

  .ctrl { display: flex; align-items: center; gap: 12px; margin-top: 26px; color: var(--dvb-ink-3); }
  .pausa { width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid var(--lc-hairline); border-radius: 3px; background: #fff; color: var(--dvb-ink); cursor: pointer; }
  .pausa .i-toca { display: none; }
  .pausa[aria-pressed="true"] .i-toca { display: block; }
  .pausa[aria-pressed="true"] .i-pausa { display: none; }

  @keyframes prog { from { width: 0; } to { width: 100%; } }

  @media (max-width: 1100px) {
    .slide { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .texto h2 { font-size: 44px; letter-spacing: -1.5px; }
  }
  @media (max-width: 760px) {
    .destaque { --u: 39px; }
    .capa img { left: -30px; top: -26px; width: calc(100% + 60px); height: calc(100% + 50px); }
    .abas { grid-template-columns: 1fr; gap: 0; margin-top: 36px; }
    .aba { padding: 18px 0 16px; grid-template-columns: 84px 1fr; gap: 14px; border-bottom: 1px solid var(--lc-hairline); }
    .aba img, .miniatura-vazia { width: 84px; height: 58px; }
    .aba strong { font-size: 18px; }
    .btn-cantos { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
    .aba.on .prog i { animation: none; width: 100%; }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-destaque]');
  if (raiz) {
    const slides = [...raiz.querySelectorAll<HTMLElement>('[data-slide]')];
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-aba]')];
    const botao = raiz.querySelector<HTMLButtonElement>('[data-pausa]');
    const status = raiz.querySelector<HTMLElement>('[data-status]');
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    raiz.style.setProperty('--n', String(abas.length));
    let atual = 0;
    let manual = false; // pausa pedida pelo botão

    const pausar = () => raiz.toggleAttribute('data-pausado', manual || raiz.matches(':hover, :focus-within') || document.hidden);

    function mostrar(i: number, foco = false) {
      atual = (i + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('on', k === atual); s.inert = k !== atual; });
      abas.forEach((a, k) => {
        a.classList.toggle('on', k === atual);
        a.setAttribute('aria-selected', String(k === atual));
        a.tabIndex = k === atual ? 0 : -1;
        // reinicia a linha de progresso da aba ativa
        const p = a.querySelector<HTMLElement>('.prog i');
        if (p) { p.style.animation = 'none'; void p.offsetWidth; p.style.animation = ''; }
      });
      if (status) status.textContent = `${atual + 1} de ${slides.length}. ${manual || semMovimento ? 'Troca só quando você escolhe.' : 'Troca sozinho e pausa quando você passa o mouse.'}`;
      if (foco) abas[atual].focus();
    }

    abas.forEach((a, k) => a.addEventListener('click', () => mostrar(k)));
    raiz.addEventListener('keydown', (e) => {
      if (!(e.target as HTMLElement).matches('[data-aba]')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); mostrar(atual + 1, true); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); mostrar(atual - 1, true); }
    });
    // a linha termina => passa para o próximo (mesma fonte de tempo da animação)
    abas.forEach((a) => a.querySelector('.prog i')?.addEventListener('animationend', () => { if (a.classList.contains('on') && !semMovimento) mostrar(atual + 1); }));

    ['mouseenter', 'mouseleave', 'focusin', 'focusout'].forEach((ev) => raiz.addEventListener(ev, pausar));
    document.addEventListener('visibilitychange', pausar);
    botao?.addEventListener('click', () => {
      manual = !manual;
      botao.setAttribute('aria-pressed', String(manual));
      botao.setAttribute('aria-label', manual ? 'Retomar a troca automática' : 'Pausar a troca automática');
      pausar();
      if (status) status.textContent = `${atual + 1} de ${slides.length}. ${manual ? 'Troca só quando você escolhe.' : 'Troca sozinho e pausa quando você passa o mouse.'}`;
    });
    if (semMovimento && botao) { botao.hidden = true; }
    mostrar(0);
  }
</script>
