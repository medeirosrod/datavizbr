---
// "Em destaque": um texto principal e até dois secundários, todos visíveis, sem troca automática.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Selo from './Selo.astro';
import Azulejo from './Azulejo.astro';
import AutorNome from './AutorNome.astro';
import { formatarMesAno, getSeriesCategoria, rotuloCategoria } from '../lib/data';
import type { Secao } from '../lib/formas';

interface Props {
  /** O primeiro é o principal; os demais (até dois) são secundários. */
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
const [principal, ...outros] = posts;
const categorias = await getSeriesCategoria();

// Corpo do título por tamanho do texto: título longo desce de corpo em vez de empilhar linhas.
const porte = (titulo: string) => (titulo.length <= 30 ? 'g' : titulo.length <= 64 ? 'm' : 'p');

// A descrição acompanha a imagem que de fato aparece.
const capa = principal.data.capa_destaque ?? principal.data.capa;
const altCapa = (principal.data.capa_destaque ? principal.data.capa_destaque_alt : principal.data.capa_alt) || principal.data.titulo;
---

<section class="destaque" aria-label="Em destaque">
  <article class="principal">
    <div class="capa">
      {capa ? <Image src={capa} alt={altCapa} width={1000} widths={[640, 1000, 1400]} sizes="(max-width: 1100px) 100vw, 810px" loading="eager" /> : <div class="capa-vazia"></div>}
      <div class="veu" aria-hidden="true"></div>
    </div>
    <div class="texto">
      <Selo secao={principal.data.secao as Secao} nome={rotuloCategoria(principal, categorias)} />
      <h2 class={`porte-${porte(principal.data.titulo)}`}><a href={`/posts/${principal.id}`}>{principal.data.titulo}</a></h2>
      <p class="lead">{principal.data.descricao || principal.data.subtitulo}</p>
      <div class="autor">
        <span class="autor-nome"><AutorNome autorId={principal.data.autores[0]?.id} /></span>
        <span class="autor-data">{formatarMesAno(principal.data.publicado_em)}</span>
      </div>
      <a class="btn btn-primary btn-cantos" href={`/posts/${principal.id}`}>
        Ler o texto<i></i><i></i><i></i><i></i>
      </a>
    </div>
  </article>

  {outros.length > 0 && (
    <ul class="outros">
      {outros.slice(0, 2).map((p) => (
        <li>
          <a class="outro" href={`/posts/${p.id}`}>
            <span class="mini">
              {p.data.capa
                ? <Image src={p.data.capa} alt="" width={208} height={140} />
                : <Azulejo secao={p.data.secao as Secao} colunas={3} linhas={2} />}
            </span>
            <span class="outro-texto">
              <Selo secao={p.data.secao as Secao} nome={rotuloCategoria(p, categorias)} />
              <strong>{p.data.titulo}</strong>
              <span class="outro-data">{formatarMesAno(p.data.publicado_em)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .destaque { --u: 78px; }
  .principal { display: grid; grid-template-columns: minmax(0, 700px) minmax(0, 1fr); gap: 64px; align-items: center; }

  .capa { position: relative; height: calc(var(--u) * 6); overflow: hidden; border-radius: 3px; background: var(--lc-dusk); }
  .capa img { max-width: none; position: absolute; left: -60px; top: -40px; width: calc(100% + 110px); height: calc(100% + 80px); object-fit: cover; }
  .capa-vazia { position: absolute; inset: 0; background: var(--lc-wall); }
  /* Véu: faixa de argila com aberturas circulares; a capa aparece por elas */
  .veu {
    position: absolute; right: 0; top: 0; bottom: 0; width: calc(var(--u) * 2);
    background:
      linear-gradient(to right, transparent calc(50% - 1px), #a9520f calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)),
      repeating-linear-gradient(to bottom, transparent 0 calc(var(--u) - 1px), #a9520f calc(var(--u) - 1px) var(--u)),
      var(--lc-clay);
    -webkit-mask: radial-gradient(circle at 50% 50%, transparent 0 calc(var(--u) * .35), #000 calc(var(--u) * .353)) 0 0 / var(--u) var(--u);
            mask: radial-gradient(circle at 50% 50%, transparent 0 calc(var(--u) * .35), #000 calc(var(--u) * .353)) 0 0 / var(--u) var(--u);
    filter: drop-shadow(-8px 0 14px rgba(42, 22, 64, .35));
  }

  .texto { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .texto h2 { line-height: 1; letter-spacing: -.01em; text-wrap: balance; }
  .texto h2.porte-g { font-size: 52px; }
  .texto h2.porte-m { font-size: 40px; }
  .texto h2.porte-p { font-size: 32px; line-height: 1.04; }
  .texto h2 a { color: var(--dvb-ink); border-bottom: 0; }
  .texto h2 a:hover { color: var(--lc-ink-orange); }
  .lead { font-family: var(--font-mono); font-size: 17px; line-height: 1.55; letter-spacing: -.2px; color: var(--dvb-ink-2); max-width: 62ch; }
  .autor { display: flex; flex-direction: column; font-size: 14px; color: var(--dvb-ink-3); }
  .autor-nome { color: var(--dvb-ink); font-weight: 600; }

  .btn-cantos { position: relative; height: 46px; padding: 0 24px; margin-top: 6px; }
  .btn-cantos i { position: absolute; width: 10px; height: 10px; border: 2px solid var(--dvb-orange-deep); opacity: 0; transition: opacity 160ms var(--ease-out), transform 220ms var(--ease-spring); }
  .btn-cantos i:nth-of-type(1) { left: -8px; top: -8px; border-right: 0; border-bottom: 0; }
  .btn-cantos i:nth-of-type(2) { right: -8px; top: -8px; border-left: 0; border-bottom: 0; }
  .btn-cantos i:nth-of-type(3) { left: -8px; bottom: -8px; border-right: 0; border-top: 0; }
  .btn-cantos i:nth-of-type(4) { right: -8px; bottom: -8px; border-left: 0; border-top: 0; }
  .btn-cantos:hover i, .btn-cantos:focus-visible i { opacity: 1; }
  .btn-cantos:hover i:nth-of-type(1), .btn-cantos:focus-visible i:nth-of-type(1) { transform: translate(-2px, -2px); }
  .btn-cantos:hover i:nth-of-type(2), .btn-cantos:focus-visible i:nth-of-type(2) { transform: translate(2px, -2px); }
  .btn-cantos:hover i:nth-of-type(3), .btn-cantos:focus-visible i:nth-of-type(3) { transform: translate(-2px, 2px); }
  .btn-cantos:hover i:nth-of-type(4), .btn-cantos:focus-visible i:nth-of-type(4) { transform: translate(2px, 2px); }
  .btn-cantos:focus-visible { outline: none; }

  /* Secundários */
  .outros { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 44px; list-style: none; }
  .outro { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 18px; align-items: center; height: 100%; padding-top: 22px; border-top: 1px solid var(--lc-hairline); border-bottom: 0; color: var(--dvb-ink-2); }
  .mini { display: block; width: 104px; height: 70px; overflow: hidden; border-radius: 3px; border: 1px solid var(--lc-hairline); background: var(--lc-cal-shade); }
  .mini img, .mini :global(svg) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .outro-texto { display: flex; flex-direction: column; gap: 6px; }
  .outro strong { font-family: var(--font-display); font-size: 20px; line-height: 1.12; letter-spacing: -.4px; color: var(--dvb-ink); text-wrap: balance; }
  .outro:hover strong { color: var(--lc-ink-orange); }
  .outro:focus-visible { outline: 2px solid var(--dvb-orange); outline-offset: 4px; }
  .outro-data { font-size: 13px; color: var(--dvb-ink-3); }

  @media (max-width: 1100px) {
    .principal { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .lead { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .texto h2.porte-g { font-size: 46px; }
    .texto h2.porte-m { font-size: 38px; }
    .texto h2.porte-p { font-size: 32px; }
  }
  @media (max-width: 760px) {
    .destaque { --u: 39px; }
    .texto h2.porte-g { font-size: 38px; }
    .texto h2.porte-m { font-size: 32px; }
    .texto h2.porte-p { font-size: 28px; }
    .capa img { left: -30px; top: -26px; width: calc(100% + 60px); height: calc(100% + 50px); }
    .outros { grid-template-columns: 1fr; gap: 0; margin-top: 32px; }
    .outro { grid-template-columns: 84px minmax(0, 1fr); gap: 14px; padding-block: 16px; }
    .mini { width: 84px; height: 58px; }
    .outro strong { font-size: 18px; }
    .btn-cantos { width: 100%; justify-content: center; }
  }
</style>
