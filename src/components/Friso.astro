---
// Friso do rodapé: fileira de blocos de 48 px alternando as quatro formas.
// Mostra a aquarela do projeto pelas aberturas (The Watercolor Rule).
import aquarela from '../assets/blog/o-vento-que-sobra/ilustracao-aquarela.jpg';
import { formaD, SECOES } from '../lib/formas';

const M = 48, N = 30;
const k = M / 80;
const blocos = Array.from({ length: N }, (_, c) => ({ x: c * M, s: SECOES[c % 4] }));
---

<svg class="friso" viewBox={`0 0 ${N * M} ${M}`} preserveAspectRatio="xMinYMid slice" aria-hidden="true">
  <defs>
    <pattern id="friso-aq" patternUnits="userSpaceOnUse" width={N * 80} height="80">
      <image href={aquarela.src} x="0" y="-560" width={N * 80} height="1500" preserveAspectRatio="xMidYMid slice" />
    </pattern>
  </defs>
  {blocos.map((b) => <rect x={b.x + 1.5} y="1.5" width={M - 3} height={M - 3} rx="2" fill="#24142f" />)}
  <g transform={`scale(${k})`}>
    {blocos.map((b) => <path d={formaD(b.s, b.x / k, 0)} fill="url(#friso-aq)" />)}
  </g>
</svg>

<style>
  .friso { display: block; width: 100%; height: 48px; }
</style>
