---
// Friso do rodapé: fileira de blocos de 48 px alternando as quatro formas.
// A luz do pôr do sol passa pelas aberturas (Sunset Wall): o degradê cruza o friso inteiro.
import { formaD, SECOES } from '../lib/formas';

const M = 48, N = 30;
const k = M / 80;
const blocos = Array.from({ length: N }, (_, c) => ({ x: c * M, s: SECOES[c % 4] }));
---

<svg class="friso" viewBox={`0 0 ${N * M} ${M}`} preserveAspectRatio="xMinYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id="friso-ceu" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={N * M} y2="0">
      <stop offset="0" stop-color="#4b2c80" />
      <stop offset=".3" stop-color="#8a58ad" />
      <stop offset=".55" stop-color="#d98aa6" />
      <stop offset=".78" stop-color="#f6ab72" />
      <stop offset="1" stop-color="#e9772a" />
    </linearGradient>
  </defs>
  {blocos.map((b) => <rect x={b.x + 1.5} y="1.5" width={M - 3} height={M - 3} rx="2" fill="#24142f" />)}
  <g transform={`scale(${k})`}>
    {blocos.map((b) => <path d={formaD(b.s, b.x / k, 0)} fill="url(#friso-ceu)" />)}
  </g>
</svg>

<style>
  .friso { display: block; width: 100%; height: 48px; }
</style>
