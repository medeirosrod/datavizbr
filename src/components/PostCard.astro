---
// Cartão de texto das páginas de seção: capa, selo da seção, título, autor e data.
import type { CollectionEntry } from 'astro:content';
import AutorNome from './AutorNome.astro';
import PostCoverDefault from './PostCoverDefault.astro';
import Selo from './Selo.astro';
import { formatarMesAno } from '../lib/data';

interface Props {
  post: CollectionEntry<'posts'>;
  /** Posição na lista, para o atraso da entrada. */
  indice?: number;
  /** Escondido de início (o texto já aparece no destaque). */
  oculto?: boolean;
}

const { post, indice = 0, oculto = false } = Astro.props;
const { titulo, secao, capa, capa_alt, autores, publicado_em } = post.data;
const ano = new Date(publicado_em).getUTCFullYear();
---

<article class="cartao" hidden={oculto} data-ano={ano} data-busca={`${titulo} ${post.data.descricao ?? ''} ${autores.map((a) => a.id).join(' ')}`.toLowerCase()} style={`--i:${Math.min(indice, 9)}`}>
  <a class="cartao-capa" href={`/posts/${post.id}`} tabindex="-1" aria-hidden="true">
    {capa ? (
      <img src={capa.src} alt="" loading="lazy" />
    ) : (
      <PostCoverDefault secao={secao} />
    )}
  </a>
  <div class="cartao-corpo">
    <Selo secao={secao} tamanho={16} />
    <h3 class="cartao-titulo"><a href={`/posts/${post.id}`}>{titulo}</a></h3>
    <p class="cartao-meta"><AutorNome autorId={autores[0]?.id} />, {formatarMesAno(publicado_em)}</p>
  </div>
</article>

<style>
  .cartao { display: flex; flex-direction: column; animation: sobe 520ms var(--ease-out) both; animation-delay: calc(var(--i) * 50ms); }
  .cartao[hidden] { display: none; }
  .cartao-capa {
    display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 3px; border-bottom: 0;
    background: var(--lc-cal-shade); box-shadow: 0 0 0 1px var(--lc-hairline);
    transition: transform 240ms var(--ease-out), box-shadow 240ms var(--ease-out);
  }
  .cartao-capa :global(img), .cartao-capa :global(svg) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 500ms var(--ease-out); }
  .cartao:hover .cartao-capa { transform: translateY(-3px); box-shadow: 0 0 0 1px var(--lc-hairline), 0 24px 34px -24px rgba(42,22,64,.5); }
  .cartao:hover .cartao-capa :global(img) { transform: scale(1.04); }
  .cartao-corpo { display: flex; flex-direction: column; gap: 10px; padding-top: 16px; }
  .cartao-titulo { font-size: 23px; line-height: 1.14; letter-spacing: -.5px; text-wrap: balance; }
  .cartao-titulo a { color: var(--fg-heading); border-bottom: 0; }
  .cartao-titulo a:hover { color: var(--lc-ink-orange); }
  .cartao-meta { font-size: 13.5px; color: var(--fg-meta); margin: 0; }
  @keyframes sobe { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .cartao { animation: none; } .cartao-capa, .cartao-capa :global(img) { transition: none; } }
</style>
